/-!
# Prime powers and the doubling lemma for the orders of `Sp(2m)`

Two arithmetic pieces on the orders generated by character values of `Sp(2m)`.
* Prime powers: when `p ∣ T_m`, with `T_m = ∑_{j=1}^m j²`, for `p ≥ 5`, `p = 3` and `p = 2`; when
  the auxiliary quantity `H` vanishes modulo `p`; the link `p ∣ [O : A] ⇔ p ∣ T_m` as a conditional
  statement whose hypothesis is the ring-theoretic step (not formalized here); the cases `q = p`,
  `q = 27`, `q = 25`.
* Half period and doubling: parts (i) and (ii), entry by entry in `ZMod n` and as equalities of
  column lattices in `U → ℤ`, and the identity `2 ŝ_n(c) = s_n(2c) − s_n(c)`.

## Main results

* `AritmeticaConductor.potencias_ge5`, `AritmeticaConductor.potencias_three`,
  `AritmeticaConductor.potencias_two`, `AritmeticaConductor.potencias_a_cond`,
  `AritmeticaConductor.potencias_q_primo`, `AritmeticaConductor.potencias_q27`,
  `AritmeticaConductor.potencias_q25`: the prime-power statements.
* `AritmeticaConductor.dobla_i`, `AritmeticaConductor.dobla_ii`, `AritmeticaConductor.dobla_ii_hat`,
  `AritmeticaConductor.two_sh`: half period and doubling.

## References

* C. Marín, *Conductors of orders generated by character values of Sp(2m)*, preprint (2026);
  programs and outputs: Zenodo, doi:10.5281/zenodo.23090540.
* C. Marín, *Where the character values of Sp(2m) at a torsion element fail to generate the ring
  of integers*, Zenodo (2026), doi:10.5281/zenodo.22813216 (a longer preprint of the same work).
-/

@[expose] public section

open Finset

namespace AritmeticaConductor

/-! ## Part 1. `prop:potencias`: arithmetic of `p ∣ T_m` -/

/-- `T_m = ∑_{j=1}^m j²`. -/
def T (m : ℕ) : ℕ := ∑ j ∈ Icc 1 m, j ^ 2

/-- `6 T_m = m (m+1) (2m+1)`. -/
theorem six_mul_T (m : ℕ) : 6 * T m = m * (m + 1) * (2 * m + 1) := by
  induction m with
  | zero => simp [T]
  | succ m ih =>
    unfold T at *
    rw [Finset.sum_Icc_succ_top (by omega), mul_add, ih]
    ring

/-- `P m = m (m+1) (2m+1)`. -/
def P (m : ℕ) : ℕ := m * (m + 1) * (2 * m + 1)

/-- `k ∣ P m` only depends on `m mod k`. -/
lemma dvd_P_iff_mod (k m : ℕ) : k ∣ P m ↔ k ∣ P (m % k) := by
  have hmod : m ≡ m % k [MOD k] := (Nat.mod_modEq m k).symm
  have h : P m ≡ P (m % k) [MOD k] :=
    (hmod.mul (hmod.add_right 1)).mul ((hmod.mul_left 2).add_right 1)
  exact h.dvd_iff dvd_rfl

lemma dvd_small {n x : ℕ} (hn : 0 < n) (hx : x < 3 * n) : n ∣ x ↔ x = 0 ∨ x = n ∨ x = 2 * n := by
  constructor
  · rintro ⟨q, rfl⟩
    have hq : q < 3 := by
      by_contra h
      have := Nat.mul_le_mul_left n (not_lt.mp h)
      omega
    interval_cases q <;> omega
  · rintro (rfl | rfl | rfl)
    · exact dvd_zero n
    · exact dvd_rfl
    · exact Dvd.intro_left 2 rfl

/-- `prop:potencias` (a), explicit form, `p ≥ 5`: `p ∣ T_m ⇔ m ≡ 0, −1, (p−1)/2 (mod p)`. -/
theorem potencias_ge5 {p : ℕ} (hp : p.Prime) (h5 : 5 ≤ p) (m : ℕ) :
    p ∣ T m ↔ m % p = 0 ∨ m % p = p - 1 ∨ m % p = (p - 1) / 2 := by
  have hcop : Nat.Coprime p 6 := by
    have h2 : Nat.Coprime p 2 := (Nat.coprime_primes hp Nat.prime_two).mpr (by omega)
    have h3 : Nat.Coprime p 3 := (Nat.coprime_primes hp Nat.prime_three).mpr (by omega)
    exact Nat.Coprime.mul_right h2 h3
  have hodd : p % 2 = 1 := by
    rcases hp.eq_two_or_odd with h | h
    · omega
    · exact h
  rw [← hcop.dvd_mul_left, six_mul_T, hp.dvd_mul, hp.dvd_mul]
  have hp0 : 0 < p := hp.pos
  have hr : m % p < p := Nat.mod_lt m hp0
  have hdm := Nat.div_add_mod m p
  have e1 : m + 1 = p * (m / p) + (m % p + 1) := by omega
  have e2 : 2 * m + 1 = p * (2 * (m / p)) + (2 * (m % p) + 1) := by
    rw [show p * (2 * (m / p)) = 2 * (p * (m / p)) by ring]; omega
  rw [Nat.dvd_iff_mod_eq_zero (n := m), e1, e2,
    (Nat.dvd_add_right (dvd_mul_right p _)), (Nat.dvd_add_right (dvd_mul_right p _)),
    dvd_small hp0 (by omega), dvd_small hp0 (by omega)]
  omega

/-- `prop:potencias` (a), explicit form, `p = 3`: `3 ∣ T_m ⇔ m ≡ 0, 4, 8 (mod 9)`. -/
theorem potencias_three (m : ℕ) : 3 ∣ T m ↔ m % 9 = 0 ∨ m % 9 = 4 ∨ m % 9 = 8 := by
  rw [← Nat.mul_dvd_mul_iff_left (by norm_num : 0 < 6), six_mul_T]
  change 18 ∣ P m ↔ _
  rw [dvd_P_iff_mod]
  have h18 : m % 18 < 18 := Nat.mod_lt m (by norm_num)
  have key : m % 9 = m % 18 % 9 := (Nat.mod_mod_of_dvd m (by norm_num : 9 ∣ 18)).symm
  rw [key]
  generalize m % 18 = r at h18 ⊢
  interval_cases r <;> decide

/-- `prop:potencias` (a), explicit form, `p = 2`: `2 ∣ T_m ⇔ m ≡ 0, 3 (mod 4)`. -/
theorem potencias_two (m : ℕ) : 2 ∣ T m ↔ m % 4 = 0 ∨ m % 4 = 3 := by
  rw [← Nat.mul_dvd_mul_iff_left (by norm_num : 0 < 6), six_mul_T]
  change 12 ∣ P m ↔ _
  rw [dvd_P_iff_mod]
  have h12 : m % 12 < 12 := Nat.mod_lt m (by norm_num)
  have key : m % 4 = m % 12 % 4 := (Nat.mod_mod_of_dvd m (by norm_num : 4 ∣ 12)).symm
  rw [key]
  generalize m % 12 = r at h12 ⊢
  interval_cases r <;> decide

/-! ### The step "it remains to say when `H ≡ 0 (mod p)`" -/

/-- The linear coefficients `h_k = T_m · C(m−1,k−1) · 2^{k−1}` (`1 ≤ k ≤ m`) are all divisible by
`p` iff `p ∣ T_m` (`m ≥ 1`; the case `k = 1` gives `h_1 = T_m`). -/
theorem dvd_all_h_iff {p m : ℕ} (hm : 1 ≤ m) :
    (∀ k ∈ Icc 1 m, p ∣ T m * (m - 1).choose (k - 1) * 2 ^ (k - 1)) ↔ p ∣ T m := by
  constructor
  · intro h
    simpa using h 1 (by simp [hm])
  · intro h k _
    exact dvd_mul_of_dvd_left (dvd_mul_of_dvd_left h _) _

open Polynomial in
/-- `prop:potencias` (a), `q = p^v`: `H = −T_m (X−2)^{m−1}` vanishes in `𝔽_p[X]` iff `p ∣ T_m`. -/
theorem H_a_eq_zero_iff (p : ℕ) [Fact p.Prime] (m : ℕ) :
    (-(C (T m : ZMod p)) * (X - C 2) ^ (m - 1) : (ZMod p)[X]) = 0 ↔ p ∣ T m := by
  rw [mul_eq_zero, neg_eq_zero, C_eq_zero, ZMod.natCast_eq_zero_iff]
  have : ((X - C 2) ^ (m - 1) : (ZMod p)[X]) ≠ 0 := pow_ne_zero _ (X_sub_C_ne_zero 2)
  tauto

open Polynomial in
/-- `prop:potencias` (b), `q = 2p^v`, `m ≥ 2`:
`H = (X−2)^{a−1} (X+2)^{b−1} (V_m(X−2) − U_m(X+2))` vanishes in `𝔽_p[X]` (`p` odd) iff
`p ∣ U_m` and `p ∣ V_m`. -/
theorem H_b_eq_zero_iff (p : ℕ) [Fact p.Prime] (hp2 : p ≠ 2) (a b U V : ℕ) :
    ((X - C 2) ^ (a - 1) * (X + C 2) ^ (b - 1) *
        (C (V : ZMod p) * (X - C 2) - C (U : ZMod p) * (X + C 2)) : (ZMod p)[X]) = 0 ↔
      p ∣ U ∧ p ∣ V := by
  have h1 : ((X - C 2) ^ (a - 1) : (ZMod p)[X]) ≠ 0 := pow_ne_zero _ (X_sub_C_ne_zero 2)
  have h2 : ((X + C 2) ^ (b - 1) : (ZMod p)[X]) ≠ 0 := pow_ne_zero _ (X_add_C_ne_zero 2)
  have h4 : (4 : ZMod p) ≠ 0 := by
    have : ((4 : ℕ) : ZMod p) ≠ 0 := by
      rw [Ne, ZMod.natCast_eq_zero_iff]
      intro h
      have hp := (Fact.out : p.Prime)
      exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp
        (hp.dvd_of_dvd_pow (show p ∣ 2 ^ 2 from h)))
    simpa using this
  rw [mul_eq_zero, mul_eq_zero, ← ZMod.natCast_eq_zero_iff, ← ZMod.natCast_eq_zero_iff]
  simp only [h1, h2, false_or]
  constructor
  · intro h
    have e2 := congrArg (eval 2) h
    have em2 := congrArg (eval (-2)) h
    simp only [eval_sub, eval_mul, eval_C, eval_X, eval_add, eval_zero] at e2 em2
    constructor
    · have : (4 : ZMod p) * U = 0 := by linear_combination -e2
      exact (mul_eq_zero.mp this).resolve_left h4
    · have : (4 : ZMod p) * V = 0 := by linear_combination -em2
      exact (mul_eq_zero.mp this).resolve_left h4
  · rintro ⟨hU, hV⟩
    simp [hU, hV]

/-- `prop:potencias` (a), **conditional link**. The ring-theoretic part of the paper's proof
(`p ∣ [O : A]` iff `p` divides every linear coefficient `h_k`, up to sign, of `e_k(η_1,…,η_m)`
in the uniformiser `t`) is taken as the hypothesis `hIdx`; the value `|h_k| = T_m C(m−1,k−1) 2^{k−1}`
(proved as `Conductor.LinearCoeff.coeff_one_esymm_sq`) as the hypothesis `hh`. Then
`p ∣ [O : A] ⇔ p ∣ T_m`. -/
theorem potencias_a_cond {p m idx : ℕ} (hm : 1 ≤ m) (h : ℕ → ℤ)
    (hIdx : p ∣ idx ↔ ∀ k ∈ Icc 1 m, (p : ℤ) ∣ h k)
    (hh : ∀ k ∈ Icc 1 m, (h k).natAbs = T m * (m - 1).choose (k - 1) * 2 ^ (k - 1)) :
    p ∣ idx ↔ p ∣ T m := by
  rw [hIdx, ← dvd_all_h_iff hm]
  refine forall₂_congr fun k hk => ?_
  rw [Int.natCast_dvd, hh k hk]

/-- Remark after `prop:potencias`: for `q = p` prime (`p ≥ 5`), `A ≠ ℤ` forces
`1 ≤ m < (p−1)/2`, and then `p ∤ T_m`. -/
theorem potencias_q_primo {p m : ℕ} (hp : p.Prime) (h5 : 5 ≤ p) (hm1 : 1 ≤ m)
    (hm : m < (p - 1) / 2) : ¬ p ∣ T m := by
  rw [potencias_ge5 hp h5, Nat.mod_eq_of_lt (by omega)]
  omega

/-- Remark after `prop:potencias`, `q = 27`: for `1 ≤ m < 27/2` with `A ≠ ℤ`
(`27 ∉ {2m+1, 2m+2}`, Proposition `prop:AZ`), `3 ∣ T_m` exactly for `m = 4, 8, 9`. -/
theorem potencias_q27 :
    (Icc 1 13).filter (fun m => 27 ≠ 2 * m + 1 ∧ 27 ≠ 2 * m + 2 ∧ 3 ∣ T m) = {4, 8, 9} := by
  decide

/-- Remark after `prop:potencias`, `q = 25`: `5 ∣ T_m` exactly for `m = 2, 4, 5, 7, 9, 10`. -/
theorem potencias_q25 :
    (Icc 1 12).filter (fun m => 25 ≠ 2 * m + 1 ∧ 25 ≠ 2 * m + 2 ∧ 5 ∣ T m) =
      {2, 4, 5, 7, 9, 10} := by
  decide

/-! ## Part 2. `lem:dobla`: half period, and doubling -/

/-- The sawtooth `s_n(0) = 0`, `s_n(c) = 2c − n` for `1 ≤ c < n`. -/
def s (n : ℕ) (c : ZMod n) : ℤ := if c.val = 0 then 0 else 2 * (c.val : ℤ) - n

/-- The signed residue `ŝ_n(c) = ĉ ∈ (−n/2, n/2)`, with `ŝ_n(n/2) = 0` for even `n`. -/
def sh (n : ℕ) (c : ZMod n) : ℤ :=
  if 2 * c.val < n then c.val else if 2 * c.val = n then 0 else (c.val : ℤ) - n

lemma mod_cases {x n : ℕ} (h : x < 2 * n) : (x < n ∧ x % n = x) ∨ (n ≤ x ∧ x % n = x - n) := by
  rcases lt_or_ge x n with h1 | h1
  · exact Or.inl ⟨h1, Nat.mod_eq_of_lt h1⟩
  · refine Or.inr ⟨h1, ?_⟩
    rw [Nat.mod_eq_sub_mod h1, Nat.mod_eq_of_lt (by omega)]

/-- `lem:dobla` (i), pointwise: `ŝ_n(c) = ½ s_n(c + n/2)` for even `n`. -/
theorem sh_eq_half (n : ℕ) [NeZero n] (hn : Even n) (c : ZMod n) :
    2 * sh n c = s n (c + ((n / 2 : ℕ) : ZMod n)) := by
  obtain ⟨k, rfl⟩ := hn
  have hk : 0 < k := by have := NeZero.pos (k + k); omega
  have hv := ZMod.val_lt c
  have hval : (c + (((k + k) / 2 : ℕ) : ZMod (k + k))).val = (c.val + k) % (k + k) := by
    rw [ZMod.val_add, ZMod.val_natCast, Nat.mod_eq_of_lt (by omega : (k + k) / 2 < k + k),
      show (k + k) / 2 = k by omega]
  unfold s sh
  rw [hval]
  rcases mod_cases (x := c.val + k) (n := k + k) (by omega) with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;>
    rw [h2] <;> split_ifs <;> push_cast <;> omega

/-- "One identity, two regimes" (after `lem:dobla`): `2 ŝ_n(c) = s_n(2c) − s_n(c)` for every `n`. -/
theorem two_sh (n : ℕ) [NeZero n] (c : ZMod n) : 2 * sh n c = s n (2 * c) - s n c := by
  have hv := ZMod.val_lt c
  have hval : (2 * c).val = (2 * c.val) % n := by
    rw [ZMod.val_mul, show (2 : ZMod n) = ((2 : ℕ) : ZMod n) by norm_num, ZMod.val_natCast,
      Nat.mul_mod, Nat.mod_mod, ← Nat.mul_mod]
  unfold s sh
  rw [hval]
  rcases mod_cases (x := 2 * c.val) (n := n) (by omega) with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;>
    rw [h2] <;> split_ifs <;> push_cast <;> omega

/-- A residue with odd representative fixes the half period: `a · (n/2) = n/2` in `ZMod n`. -/
lemma mul_half_of_odd {n : ℕ} [NeZero n] (hn : Even n) (a : ZMod n) (ha : Odd a.val) :
    a * ((n / 2 : ℕ) : ZMod n) = ((n / 2 : ℕ) : ZMod n) := by
  obtain ⟨k, rfl⟩ := hn
  obtain ⟨j, hj⟩ := ha
  rw [← ZMod.natCast_zmod_val a, ← Nat.cast_mul, ZMod.natCast_eq_natCast_iff', hj,
    show (k + k) / 2 = k by omega,
    show (2 * j + 1) * k = k + (k + k) * j by ring, Nat.add_mul_mod_self_left]

/-- A unit modulo an even `n` is odd. -/
lemma odd_val_of_unit {n : ℕ} (hn : Even n) (a : (ZMod n)ˣ) : Odd (a : ZMod n).val := by
  have hc := ZMod.val_coe_unit_coprime a
  rcases Nat.even_or_odd (a : ZMod n).val with h | h
  · exfalso
    have h2 : 2 ∣ Nat.gcd (a : ZMod n).val n :=
      Nat.dvd_gcd (even_iff_two_dvd.mp h) (even_iff_two_dvd.mp hn)
    rw [Nat.Coprime.gcd_eq_one hc] at h2
    omega
  · exact h

variable {U : Type*}

/-- The column `c` of the matrix `[f(w_u · c)]_u` (rows indexed by `u : U`, multiplier `w_u`). -/
def col (n : ℕ) (f : ZMod n → ℤ) (w : U → ZMod n) (c : ZMod n) : U → ℤ := fun u => f (w u * c)

/-- The column lattice: the `ℤ`-span of the columns `c ∈ ZMod n`. -/
def L (n : ℕ) (f : ZMod n → ℤ) (w : U → ZMod n) : Submodule ℤ (U → ℤ) :=
  Submodule.span ℤ (Set.range (col n f w))

/-- The paper indexes the columns of `M_n` by `1 ≤ c < n`; adjoining the zero column `c = 0`
does not change the lattice. -/
theorem L_sin_cero (n : ℕ) [NeZero n] (w : U → ZMod n) :
    Submodule.span ℤ (col n (s n) w '' {c | c ≠ 0}) = L n (s n) w := by
  have h0 : col n (s n) w 0 = 0 := by ext; simp [col, s]
  have : Set.range (col n (s n) w) = insert 0 (col n (s n) w '' {c | c ≠ 0}) := by
    ext x
    simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_image, Set.mem_ofPred_eq]
    constructor
    · rintro ⟨c, rfl⟩
      by_cases hc : c = 0
      · left; rw [hc, h0]
      · right; exact ⟨c, hc, rfl⟩
    · rintro (rfl | ⟨c, _, rfl⟩)
      · exact ⟨0, h0⟩
      · exact ⟨c, rfl⟩
  rw [L, this, Submodule.span_insert_zero]

open scoped Pointwise

/-- `lem:dobla` (i), column by column: the column `c` of `M̂_n` is half the column `c + n/2`
of `M_n`, for any multipliers `w_u` with odd representatives. -/
theorem dobla_i_col (n : ℕ) [NeZero n] (hn : Even n) (w : U → ZMod n)
    (hw : ∀ u, Odd (w u).val) (c : ZMod n) :
    (2 : ℤ) • col n (sh n) w c = col n (s n) w (c + ((n / 2 : ℕ) : ZMod n)) := by
  funext u
  simp only [col, Pi.smul_apply, smul_eq_mul]
  rw [mul_add, mul_half_of_odd hn _ (hw u), sh_eq_half n hn]

/-- `lem:dobla` (i), lattices, general multipliers with odd representatives: `L_n = 2 L'_n`. -/
theorem dobla_i_core (n : ℕ) [NeZero n] (hn : Even n) (w : U → ZMod n)
    (hw : ∀ u, Odd (w u).val) : L n (s n) w = (2 : ℤ) • L n (sh n) w := by
  rw [L, L, Submodule.smul_span]
  congr 1
  ext x
  simp only [Set.mem_range, Set.mem_smul_set]
  constructor
  · rintro ⟨c, rfl⟩
    refine ⟨col n (sh n) w (c - ((n / 2 : ℕ) : ZMod n)), ⟨_, rfl⟩, ?_⟩
    rw [dobla_i_col n hn w hw, sub_add_cancel]
  · rintro ⟨_, ⟨c, rfl⟩, rfl⟩
    exact ⟨_, (dobla_i_col n hn w hw c).symm⟩

/-- `lem:dobla` (i) as stated: rows indexed by representatives `ι u` of `(ℤ/n)ˣ/±1` (any family
of units), `M_n = [s_n(u⁻¹c)]`, `M̂_n = [ŝ_n(u⁻¹c)]`; then `L_n = 2 L'_n`, i.e. `L'_n = ½ L_n`. -/
theorem dobla_i (n : ℕ) [NeZero n] (hn : Even n) (ι : U → (ZMod n)ˣ) :
    L n (s n) (fun u => ((ι u)⁻¹ : (ZMod n)ˣ)) =
      (2 : ℤ) • L n (sh n) (fun u => ((ι u)⁻¹ : (ZMod n)ˣ)) :=
  dobla_i_core n hn _ (fun _ => odd_val_of_unit hn _)

/-! ### `lem:dobla` (ii): `n = 2r`, `r` odd -/

/-- Reduction `ZMod (2r) → ZMod r`. -/
abbrev red (r : ℕ) : ZMod (2 * r) →+* ZMod r := ZMod.castHom (dvd_mul_left r 2) (ZMod r)

/-- The even lift `c ↦ 2c` of `ZMod r` into `ZMod (2r)`. -/
def emb (r : ℕ) (c : ZMod r) : ZMod (2 * r) := ((2 * c.val : ℕ) : ZMod (2 * r))

section Doubling

variable {r : ℕ} [NeZero r]

lemma red_eq (e : ZMod (2 * r)) : red r e = ((e.val : ℕ) : ZMod r) := by
  rw [ZMod.castHom_apply, ZMod.cast_eq_val]

lemma emb_val (c : ZMod r) : (emb r c).val = 2 * c.val :=
  ZMod.val_cast_of_lt (by have := ZMod.val_lt c; omega)

/-- `s_{2r}(2c) = 2 s_r(c)`. -/
lemma s_emb (c : ZMod r) : s (2 * r) (emb r c) = 2 * s r c := by
  unfold s
  rw [emb_val]
  split_ifs <;> push_cast <;> omega

/-- `x · (2c) = 2 (x c)`: multiplication commutes with the even lift. -/
lemma mul_emb (x : ZMod (2 * r)) (c : ZMod r) : x * emb r c = emb r (red r x * c) := by
  rw [red_eq, emb, emb]
  conv_lhs => rw [← ZMod.natCast_zmod_val x]
  rw [← Nat.cast_mul, ZMod.natCast_eq_natCast_iff, ZMod.val_mul, ZMod.val_natCast]
  have h : (x.val % r * c.val) % r ≡ x.val * c.val [MOD r] :=
    (Nat.mod_modEq _ _).trans ((Nat.mod_modEq _ _).mul_right _)
  rw [show x.val * (2 * c.val) = 2 * (x.val * c.val) by ring]
  exact (h.mul_left' 2).symm

omit [NeZero r] in
/-- `c* = 2⁻¹ c` is characterised by `2 c* = c` (`r` odd). -/
lemma half_eq (hr : Odd r) {c e : ZMod r} (h : 2 * e = c) : (2 : ZMod r)⁻¹ * c = e := by
  have h2 : (2 : ZMod r) * (2 : ZMod r)⁻¹ = 1 := by
    have := ZMod.coe_mul_inv_eq_one 2 (Nat.coprime_two_left.mpr hr)
    simpa using this
  linear_combination (-(2 : ZMod r)⁻¹) * h + e * h2

/-- `s_{2r}(ν(c)) = 2 (s_r(c) − s_r(c*))`: for `e ∈ ZMod (2r)` with odd representative,
`c = e mod r` and `c* = 2⁻¹ c`. -/
lemma s_odd (hr : Odd r) (e : ZMod (2 * r)) (he : Odd e.val) :
    s (2 * r) e = 2 * (s r (red r e) - s r ((2 : ZMod r)⁻¹ * red r e)) := by
  have hv := ZMod.val_lt e
  obtain ⟨j, hj⟩ := he
  obtain ⟨i, hi⟩ := hr
  rcases lt_or_ge e.val r with h | h
  · have hc : (2 : ZMod r)⁻¹ * red r e = (((e.val + r) / 2 : ℕ) : ZMod r) := by
      apply half_eq ⟨i, hi⟩
      have : ((2 * ((e.val + r) / 2) : ℕ) : ZMod r) = ((e.val : ℕ) : ZMod r) := by
        rw [show 2 * ((e.val + r) / 2) = e.val + r by omega, Nat.cast_add, ZMod.natCast_self,
          add_zero]
      rw [red_eq]
      exact_mod_cast this
    rw [hc, red_eq]
    unfold s
    rw [ZMod.val_cast_of_lt h, ZMod.val_cast_of_lt (by omega : (e.val + r) / 2 < r)]
    split_ifs <;> push_cast <;> omega
  · have hc' : red r e = ((e.val - r : ℕ) : ZMod r) := by
      rw [red_eq]
      conv_lhs => rw [show e.val = (e.val - r) + r by omega]
      rw [Nat.cast_add, ZMod.natCast_self, add_zero]
    have hc : (2 : ZMod r)⁻¹ * red r e = (((e.val - r) / 2 : ℕ) : ZMod r) := by
      apply half_eq ⟨i, hi⟩
      have : ((2 * ((e.val - r) / 2) : ℕ) : ZMod r) = ((e.val - r : ℕ) : ZMod r) := by
        rw [show 2 * ((e.val - r) / 2) = e.val - r by omega]
      rw [hc']
      exact_mod_cast this
    rw [hc, hc']
    unfold s
    rw [ZMod.val_cast_of_lt (by omega : e.val - r < r),
      ZMod.val_cast_of_lt (by omega : (e.val - r) / 2 < r)]
    split_ifs <;> push_cast <;> omega

omit [NeZero r] in
lemma odd_mul_val (x d : ZMod (2 * r)) (hx : Odd x.val) (hd : Odd d.val) : Odd (x * d).val := by
  rw [ZMod.val_mul, Nat.odd_iff, Nat.mod_mod_of_dvd _ (dvd_mul_right 2 r), ← Nat.odd_iff]
  exact hx.mul hd

lemma even_eq_emb (d : ZMod (2 * r)) (hd : Even d.val) :
    d = emb r ((d.val / 2 : ℕ) : ZMod r) := by
  have hv := ZMod.val_lt d
  obtain ⟨k, hk⟩ := hd
  rw [emb, ZMod.val_cast_of_lt (by omega), show 2 * (d.val / 2) = d.val by omega,
    ZMod.natCast_zmod_val]

/-- `lem:dobla` (ii), even columns: column `2c` of `M_{2r}` is twice column `c` of `M_r`. -/
theorem dobla_ii_col_even (w : U → ZMod (2 * r)) (c : ZMod r) :
    col (2 * r) (s (2 * r)) w (emb r c) = (2 : ℤ) • col r (s r) (fun u => red r (w u)) c := by
  funext u
  simp only [col, Pi.smul_apply, smul_eq_mul]
  rw [mul_emb, s_emb]

/-- `lem:dobla` (ii), odd columns: column `ν(c)` of `M_{2r}` is twice the difference of the
columns `c` and `c* = 2⁻¹c` of `M_r` (rows with odd multipliers `w_u`). -/
theorem dobla_ii_col_odd (hr : Odd r) (w : U → ZMod (2 * r)) (hw : ∀ u, Odd (w u).val)
    (d : ZMod (2 * r)) (hd : Odd d.val) :
    col (2 * r) (s (2 * r)) w d = (2 : ℤ) • (col r (s r) (fun u => red r (w u)) (red r d) -
      col r (s r) (fun u => red r (w u)) ((2 : ZMod r)⁻¹ * red r d)) := by
  funext u
  simp only [col, Pi.smul_apply, Pi.sub_apply, smul_eq_mul]
  rw [s_odd hr _ (odd_mul_val _ _ (hw u) hd), map_mul, mul_left_comm ((2 : ZMod r)⁻¹)]

/-- `lem:dobla` (ii), lattices, general odd multipliers: `L_{2r} = 2 L_r`. -/
theorem dobla_ii_core (hr : Odd r) (w : U → ZMod (2 * r)) (hw : ∀ u, Odd (w u).val) :
    L (2 * r) (s (2 * r)) w = (2 : ℤ) • L r (s r) (fun u => red r (w u)) := by
  rw [L, L, Submodule.smul_span]
  apply le_antisymm
  · rw [Submodule.span_le]
    rintro _ ⟨d, rfl⟩
    rcases Nat.even_or_odd d.val with hd | hd
    · rw [even_eq_emb d hd, dobla_ii_col_even]
      exact Submodule.subset_span (Set.smul_mem_smul_set ⟨_, rfl⟩)
    · rw [dobla_ii_col_odd hr w hw d hd, smul_sub]
      exact Submodule.sub_mem _ (Submodule.subset_span (Set.smul_mem_smul_set ⟨_, rfl⟩))
        (Submodule.subset_span (Set.smul_mem_smul_set ⟨_, rfl⟩))
  · rw [Submodule.span_le]
    rintro _ ⟨_, ⟨c, rfl⟩, rfl⟩
    beta_reduce
    rw [← dobla_ii_col_even]
    exact Submodule.subset_span ⟨_, rfl⟩

/-- The odd representative `u` (coprime to `r`) has an odd inverse modulo `2r`, which reduces
to the inverse modulo `r`. -/
lemma inv_odd_red (u : ℕ) (hu : Odd u) (hcop : Nat.Coprime u r) :
    Odd ((u : ZMod (2 * r))⁻¹).val ∧ red r ((u : ZMod (2 * r))⁻¹) = (u : ZMod r)⁻¹ := by
  have hcop2 : Nat.Coprime u (2 * r) :=
    Nat.Coprime.mul_right (Nat.coprime_two_right.mpr hu) hcop
  have h1 := ZMod.coe_mul_inv_eq_one u hcop2
  constructor
  · have h2 := congrArg (ZMod.castHom (dvd_mul_right 2 r) (ZMod 2)) h1
    rw [map_mul, map_one, map_natCast, ZMod.castHom_apply, ZMod.cast_eq_val] at h2
    have hne := right_ne_zero_of_mul_eq_one h2
    rw [Ne, ZMod.natCast_eq_zero_iff_even] at hne
    rcases Nat.even_or_odd ((u : ZMod (2 * r))⁻¹).val with h | h
    · exact absurd h hne
    · exact h
  · have h2 := congrArg (red r) h1
    rw [map_mul, map_one, map_natCast] at h2
    exact (ZMod.inv_eq_of_mul_eq_one r _ _ h2).symm

/-- `lem:dobla` (ii) as stated: rows indexed by the same odd representatives `ι u` (coprime to
`r`) of `(ℤ/r)ˣ/±1 = (ℤ/2r)ˣ/±1`, `M_r = [s_r(u⁻¹c)]`, `M_{2r} = [s_{2r}(u⁻¹c)]`:
`L_{2r} = 2 L_r`. -/
theorem dobla_ii (hr : Odd r) (ι : U → ℕ) (hodd : ∀ u, Odd (ι u))
    (hcop : ∀ u, Nat.Coprime (ι u) r) :
    L (2 * r) (s (2 * r)) (fun u => ((ι u : ℕ) : ZMod (2 * r))⁻¹) =
      (2 : ℤ) • L r (s r) (fun u => ((ι u : ℕ) : ZMod r)⁻¹) := by
  have hfun : (fun u => red r (((ι u : ℕ) : ZMod (2 * r))⁻¹)) = fun u => ((ι u : ℕ) : ZMod r)⁻¹ :=
    funext fun u => (inv_odd_red _ (hodd u) (hcop u)).2
  rw [dobla_ii_core hr _ (fun u => (inv_odd_red _ (hodd u) (hcop u)).1), hfun]

/-- `lem:dobla` (ii), "hence `L'_{2r} = L_r`": the half-period lattice at `2r` equals the
lattice of `M_r`. -/
theorem dobla_ii_hat (hr : Odd r) (ι : U → ℕ) (hodd : ∀ u, Odd (ι u))
    (hcop : ∀ u, Nat.Coprime (ι u) r) :
    L (2 * r) (sh (2 * r)) (fun u => ((ι u : ℕ) : ZMod (2 * r))⁻¹) =
      L r (s r) (fun u => ((ι u : ℕ) : ZMod r)⁻¹) := by
  have hi := dobla_i_core (2 * r) (even_two_mul r) (fun u => ((ι u : ℕ) : ZMod (2 * r))⁻¹)
    (fun u => (inv_odd_red _ (hodd u) (hcop u)).1)
  rw [dobla_ii hr ι hodd hcop] at hi
  have hinj : Function.Injective (DistribSMul.toLinearMap ℤ (U → ℤ) (2 : ℤ)) := by
    intro x y h
    funext u
    have := congrFun h u
    simp only [DistribSMul.toLinearMap_apply, Pi.smul_apply, smul_eq_mul] at this
    omega
  exact (Submodule.map_injective_of_injective hinj hi).symm

end Doubling

