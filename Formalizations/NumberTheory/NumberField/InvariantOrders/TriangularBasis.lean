/-!
# The quotient `A/ℤ[α]` of a quartic order with a triangular basis

In the model of `Saturation` (`K = ℚ(α)` as `ℚ⁴`, `ℤ[α] = ℤ⁴`), an order `M` is given with a
triangular `ℤ`-basis `1, ω₁, ω₂, ω₃`, `ω_k = (αᵏ + P_k(α))/d_k`, `P_k ∈ ℤ[X]` of degree `< k`,
`0 < d₁ ∣ d₂ ∣ d₃` (the structure `Louboutin.Triang`; the existence of such a basis is cited from
Louboutin 2020, Prop. 10, and Cohen 1993, Cor. 4.7.6, and enters as data). That it is a basis,
that `ℤ[α] ⊆ M`, and the flags `M ∩ V_k = ℤ + ℤω₁ + … + ℤω_k` are proved. For `M = A` the
hypothesis `d₁ = 1` is Louboutin's Theorem 13. `Triang.ofData` realizes every datum, so the
hypotheses are not contradictory.

## Main results

* `Louboutin.Triang.quotient_equiv`: `M/ℤ[α] ≃+ ℤ/d₁ × ℤ/d₂ × ℤ/d₃`.
* `Louboutin.Triang.quotient_equiv_T1`, `Louboutin.Triang.index_V2`: with `d₁ = 1`,
  `A/ℤ[α] ≃+ ℤ/d₂ × ℤ/d₃` and `[A ∩ V₂ : L₂] = d₂`.
* `Louboutin.Triang.T1_i_iff_ii`, `T1_ii_iff_iii`, `T1_iii_iff_iv`, `T1_iii_iff_v`,
  `Louboutin.Triang.prop_T1`: the five equivalent conditions.
* `Louboutin.Triang.T1_mod_p`: `p ∣ d₂` iff `1, α, α²` are dependent over `𝔽_p` in `A/pA`.

## References

* S. R. Louboutin, *On the order generated by the conjugates of an algebraic integer*, in:
  Algebra, Logic and Number Theory, Banach Center Publ. 121 (2020), 107–124, doi:10.4064/bc121-10.
* S. R. Louboutin, *When is the order generated by a cubic, quartic or quintic algebraic unit Galois
  invariant: three conjectures*, Czechoslovak Math. J. 70 (2020), 905–919,
  doi:10.21136/CMJ.2020.0019-19.
* C. Marín, *Orders generated by conjugates of Galois quartic integers*, preprint (2026).
-/

@[expose] public section

namespace Louboutin

/-- `apow i = αⁱ` in the power basis. -/
abbrev apow (i : Fin 4) : Fin 4 → ℚ := Pi.single i 1

/-- V₂ = ℚ + ℚα + ℚα². -/
def V2 : AddSubgroup (Fin 4 → ℚ) where
  carrier := {x | x 3 = 0}
  zero_mem' := rfl
  add_mem' := by
    intro a b ha hb
    simp only [Set.mem_ofPred_eq, Pi.add_apply] at *
    rw [ha, hb, add_zero]
  neg_mem' := by
    intro a ha
    simp only [Set.mem_ofPred_eq, Pi.neg_apply] at *
    rw [ha, neg_zero]

/-- L₂ = ℤ + ℤα + ℤα² = ℤ[α] ∩ V₂. -/
def L2 : AddSubgroup (Fin 4 → ℚ) := Z4 ⊓ V2

/-- ω₁ = (α + a)/d. -/
def omega1 (d : ℕ) (a : ℤ) : Fin 4 → ℚ := ![a / d, 1 / d, 0, 0]
/-- ω₂ = (α² + bα + a)/d. -/
def omega2 (d : ℕ) (a b : ℤ) : Fin 4 → ℚ := ![a / d, b / d, 1 / d, 0]
/-- ω₃ = (α³ + cα² + bα + a)/d. -/
def omega3 (d : ℕ) (a b c : ℤ) : Fin 4 → ℚ := ![a / d, b / d, c / d, 1 / d]

/-- n₀ + n₁ω₁ + n₂ω₂ + n₃ω₃. -/
def combOf (ω₁ ω₂ ω₃ : Fin 4 → ℚ) (n : Fin 4 → ℤ) : Fin 4 → ℚ :=
  n 0 • apow 0 + n 1 • ω₁ + n 2 • ω₂ + n 3 • ω₃

/-- The triangular basis of the order `M` (cited, taken as data): `1, ω₁, ω₂, ω₃` with
    `ω_k = (αᵏ + P_k(α))/d_k`, `P_k ∈ ℤ[X]`, `deg P_k < k`, and `d₁ ∣ d₂ ∣ d₃`. -/
structure Triang (M : AddSubgroup (Fin 4 → ℚ)) where
  d₁ : ℕ
  d₂ : ℕ
  d₃ : ℕ
  d₁_pos : 0 < d₁
  d₂_pos : 0 < d₂
  d₃_pos : 0 < d₃
  d₁_dvd : d₁ ∣ d₂
  d₂_dvd : d₂ ∣ d₃
  p₁₀ : ℤ
  p₂₀ : ℤ
  p₂₁ : ℤ
  p₃₀ : ℤ
  p₃₁ : ℤ
  p₃₂ : ℤ
  one_mem : apow 0 ∈ M
  ω₁_mem : omega1 d₁ p₁₀ ∈ M
  ω₂_mem : omega2 d₂ p₂₀ p₂₁ ∈ M
  ω₃_mem : omega3 d₃ p₃₀ p₃₁ p₃₂ ∈ M
  span : ∀ x ∈ M, ∃ n : Fin 4 → ℤ,
    x = combOf (omega1 d₁ p₁₀) (omega2 d₂ p₂₀ p₂₁) (omega3 d₃ p₃₀ p₃₁ p₃₂) n

namespace Triang

variable {M : AddSubgroup (Fin 4 → ℚ)} (B : Triang M)

/-- `ω₁` of the triangular basis. -/
def ω₁ : Fin 4 → ℚ := omega1 B.d₁ B.p₁₀
/-- `ω₂` of the triangular basis. -/
def ω₂ : Fin 4 → ℚ := omega2 B.d₂ B.p₂₀ B.p₂₁
/-- `ω₃` of the triangular basis. -/
def ω₃ : Fin 4 → ℚ := omega3 B.d₃ B.p₃₀ B.p₃₁ B.p₃₂
/-- Coordinates in the basis `1, ω₁, ω₂, ω₃`. -/
def comb (n : Fin 4 → ℤ) : Fin 4 → ℚ := combOf B.ω₁ B.ω₂ B.ω₃ n

theorem d₁_q : (B.d₁ : ℚ) ≠ 0 := by exact_mod_cast B.d₁_pos.ne'
theorem d₂_q : (B.d₂ : ℚ) ≠ 0 := by exact_mod_cast B.d₂_pos.ne'
theorem d₃_q : (B.d₃ : ℚ) ≠ 0 := by exact_mod_cast B.d₃_pos.ne'

theorem comb_apply_zero (n : Fin 4 → ℤ) :
    B.comb n 0 = n 0 + n 1 * B.p₁₀ / B.d₁ + n 2 * B.p₂₀ / B.d₂ + n 3 * B.p₃₀ / B.d₃ := by
  simp [comb, combOf, ω₁, ω₂, ω₃, omega1, omega2, omega3]
  ring

theorem comb_apply_one (n : Fin 4 → ℤ) :
    B.comb n 1 = n 1 / B.d₁ + n 2 * B.p₂₁ / B.d₂ + n 3 * B.p₃₁ / B.d₃ := by
  simp [comb, combOf, ω₁, ω₂, ω₃, omega1, omega2, omega3]
  ring

theorem comb_apply_two (n : Fin 4 → ℤ) :
    B.comb n 2 = n 2 / B.d₂ + n 3 * B.p₃₂ / B.d₃ := by
  simp [comb, combOf, ω₁, ω₂, ω₃, omega1, omega2, omega3]
  ring

theorem comb_apply_three (n : Fin 4 → ℤ) : B.comb n 3 = n 3 / B.d₃ := by
  simp [comb, combOf, ω₁, ω₂, ω₃, omega1, omega2, omega3]
  ring

/-- Auxiliary: if `k = n/d + q` with `k`, `q` integers, then `d ∣ n`. -/
theorem dvd_of_cast_eq {d : ℕ} (hd : 0 < d) {n k q : ℤ} (h : (k : ℚ) = n / d + q) :
    (d : ℤ) ∣ n := by
  have hd0 : (d : ℚ) ≠ 0 := by exact_mod_cast hd.ne'
  refine ⟨k - q, ?_⟩
  have : (n : ℚ) = d * (k - q) := by
    rw [h]; field_simp; ring
  exact_mod_cast this

/-- Key lemma: `n₀ + n₁ω₁ + n₂ω₂ + n₃ω₃ ∈ ℤ[α] ↔ d₁ ∣ n₁, d₂ ∣ n₂, d₃ ∣ n₃`. -/
theorem comb_mem_Z4_iff (n : Fin 4 → ℤ) :
    B.comb n ∈ Z4 ↔ (B.d₁ : ℤ) ∣ n 1 ∧ (B.d₂ : ℤ) ∣ n 2 ∧ (B.d₃ : ℤ) ∣ n 3 := by
  have h1q := B.d₁_q
  have h2q := B.d₂_q
  have h3q := B.d₃_q
  constructor
  · intro h
    obtain ⟨k3, h3⟩ := h 3
    obtain ⟨k2, h2⟩ := h 2
    obtain ⟨k1, h1⟩ := h 1
    rw [B.comb_apply_three] at h3
    rw [B.comb_apply_two] at h2
    rw [B.comb_apply_one] at h1
    have e3 : (B.d₃ : ℤ) ∣ n 3 := dvd_of_cast_eq B.d₃_pos (k := k3) (q := 0) (by rw [h3]; simp)
    obtain ⟨m3, hm3⟩ := e3
    have e2 : (B.d₂ : ℤ) ∣ n 2 := dvd_of_cast_eq B.d₂_pos (k := k2) (q := m3 * B.p₃₂) (by
      rw [h2, hm3]; push_cast; field_simp)
    obtain ⟨m2, hm2⟩ := e2
    have e1 : (B.d₁ : ℤ) ∣ n 1 := dvd_of_cast_eq B.d₁_pos (k := k1)
        (q := m2 * B.p₂₁ + m3 * B.p₃₁) (by
      rw [h1, hm2, hm3]; push_cast; field_simp; ring)
    exact ⟨e1, ⟨m2, hm2⟩, ⟨m3, hm3⟩⟩
  · rintro ⟨⟨a1, ha1⟩, ⟨a2, ha2⟩, ⟨a3, ha3⟩⟩ i
    fin_cases i
    · refine ⟨n 0 + a1 * B.p₁₀ + a2 * B.p₂₀ + a3 * B.p₃₀, ?_⟩
      show _ = B.comb n 0
      rw [B.comb_apply_zero, ha1, ha2, ha3]; push_cast; field_simp
    · refine ⟨a1 + a2 * B.p₂₁ + a3 * B.p₃₁, ?_⟩
      show _ = B.comb n 1
      rw [B.comb_apply_one, ha1, ha2, ha3]; push_cast; field_simp
    · refine ⟨a2 + a3 * B.p₃₂, ?_⟩
      show _ = B.comb n 2
      rw [B.comb_apply_two, ha2, ha3]; push_cast; field_simp
    · refine ⟨a3, ?_⟩
      show _ = B.comb n 3
      rw [B.comb_apply_three, ha3]; push_cast; field_simp

theorem comb_add (n m : Fin 4 → ℤ) : B.comb (n + m) = B.comb n + B.comb m := by
  simp only [comb, combOf, Pi.add_apply, add_smul]; abel

theorem comb_zero : B.comb 0 = 0 := by simp [comb, combOf]

theorem comb_mem (n : Fin 4 → ℤ) : B.comb n ∈ M :=
  M.add_mem (M.add_mem (M.add_mem (M.zsmul_mem B.one_mem _) (M.zsmul_mem B.ω₁_mem _))
    (M.zsmul_mem B.ω₂_mem _)) (M.zsmul_mem B.ω₃_mem _)

/-- `comb` as a homomorphism `ℤ⁴ → M`. -/
def combHom : (Fin 4 → ℤ) →+ M where
  toFun n := ⟨B.comb n, B.comb_mem n⟩
  map_zero' := Subtype.ext B.comb_zero
  map_add' n m := Subtype.ext (B.comb_add n m)

theorem combHom_surjective : Function.Surjective B.combHom := by
  rintro ⟨x, hx⟩
  obtain ⟨n, hn⟩ := B.span x hx
  exact ⟨n, Subtype.ext hn.symm⟩

/-- `1, ω₁, ω₂, ω₃` are linearly independent: a `ℤ`-basis of `M`. -/
theorem comb_injective : Function.Injective B.comb := by
  intro n m h
  have h1q := B.d₁_q
  have h2q := B.d₂_q
  have h3q := B.d₃_q
  have c3 := congrFun h 3
  have c2 := congrFun h 2
  have c1 := congrFun h 1
  have c0 := congrFun h 0
  rw [B.comb_apply_three, B.comb_apply_three] at c3
  rw [B.comb_apply_two, B.comb_apply_two] at c2
  rw [B.comb_apply_one, B.comb_apply_one] at c1
  rw [B.comb_apply_zero, B.comb_apply_zero] at c0
  have e3 : (n 3 : ℚ) = m 3 := (div_left_inj' h3q).mp c3
  rw [e3] at c2 c1 c0
  have e2 : (n 2 : ℚ) = m 2 := (div_left_inj' h2q).mp (add_right_cancel c2)
  rw [e2] at c1 c0
  have e1 : (n 1 : ℚ) = m 1 := (div_left_inj' h1q).mp (add_right_cancel (add_right_cancel c1))
  rw [e1] at c0
  have e0 : (n 0 : ℚ) = m 0 := add_right_cancel (add_right_cancel (add_right_cancel c0))
  funext i
  fin_cases i
  · exact_mod_cast e0
  · exact_mod_cast e1
  · exact_mod_cast e2
  · exact_mod_cast e3

/-- Flags, `k = 2`: `M ∩ V₂ = ℤ + ℤω₁ + ℤω₂`. -/
theorem inter_V2 {x : Fin 4 → ℚ} (hx : x ∈ M) (h3 : x 3 = 0) :
    ∃ n : Fin 4 → ℤ, n 3 = 0 ∧ x = B.comb n := by
  obtain ⟨n, rfl⟩ := B.span x hx
  refine ⟨n, ?_, rfl⟩
  have h := h3
  change B.comb n 3 = 0 at h
  rw [B.comb_apply_three, div_eq_zero_iff] at h
  rcases h with h | h
  · exact_mod_cast h
  · exact absurd h B.d₃_q

/-- Flags, `k = 1`: `M ∩ V₁ = ℤ + ℤω₁`. -/
theorem inter_V1 {x : Fin 4 → ℚ} (hx : x ∈ M) (h3 : x 3 = 0) (h2 : x 2 = 0) :
    ∃ n : Fin 4 → ℤ, n 3 = 0 ∧ n 2 = 0 ∧ x = B.comb n := by
  obtain ⟨n, hn3, rfl⟩ := B.inter_V2 hx h3
  refine ⟨n, hn3, ?_, rfl⟩
  have h := h2
  change B.comb n 2 = 0 at h
  rw [B.comb_apply_two, hn3] at h
  simp only [Int.cast_zero, zero_mul, zero_div, add_zero, div_eq_zero_iff] at h
  rcases h with h | h
  · exact_mod_cast h
  · exact absurd h B.d₂_q

include B in
/-- ℤ[α] ⊆ M. -/
theorem Z4_le : Z4 ≤ M := by
  intro x hx
  choose k hk using hx
  -- `x` is the image of an explicit coefficient vector (triangular inversion)
  have h1q := B.d₁_q
  have h2q := B.d₂_q
  have h3q := B.d₃_q
  set m3 : ℤ := B.d₃ * k 3
  set m2 : ℤ := B.d₂ * (k 2 - k 3 * B.p₃₂)
  set m1 : ℤ := B.d₁ * (k 1 - (k 2 - k 3 * B.p₃₂) * B.p₂₁ - k 3 * B.p₃₁)
  set m0 : ℤ := k 0 - (k 1 - (k 2 - k 3 * B.p₃₂) * B.p₂₁ - k 3 * B.p₃₁) * B.p₁₀
    - (k 2 - k 3 * B.p₃₂) * B.p₂₀ - k 3 * B.p₃₀
  have : x = B.comb ![m0, m1, m2, m3] := by
    funext i
    fin_cases i
    · show x 0 = B.comb _ 0
      rw [B.comb_apply_zero, ← hk 0]; simp [m0, m1, m2, m3]; field_simp; ring
    · show x 1 = B.comb _ 1
      rw [B.comb_apply_one, ← hk 1]; simp [m1, m2, m3]; field_simp; ring
    · show x 2 = B.comb _ 2
      rw [B.comb_apply_two, ← hk 2]; simp [m2, m3]; field_simp; ring
    · show x 3 = B.comb _ 3
      rw [B.comb_apply_three, ← hk 3]; simp [m3]; field_simp
  rw [this]; exact B.comb_mem _

theorem comb_zsmul (k : ℤ) (n : Fin 4 → ℤ) : B.comb (k • n) = k • B.comb n := by
  exact congrArg Subtype.val (map_zsmul B.combHom k n)

theorem comb_nsmul (k : ℕ) (n : Fin 4 → ℤ) : B.comb (k • n) = k • B.comb n := by
  exact congrArg Subtype.val (map_nsmul B.combHom k n)

/-- `(M ∩ V₂)/L₂` is killed by `d₂`: `x ∈ M`, `x ∈ V₂` ⇒ `d₂ x ∈ ℤ[α]`. -/
theorem d₂_smul_mem {x : Fin 4 → ℚ} (hx : x ∈ M) (h3 : x 3 = 0) : (B.d₂ : ℤ) • x ∈ Z4 := by
  obtain ⟨n, hn3, rfl⟩ := B.inter_V2 hx h3
  rw [← B.comb_zsmul, B.comb_mem_Z4_iff]
  simp only [Pi.smul_apply, smul_eq_mul, hn3, mul_zero, dvd_zero, and_true]
  exact ⟨Dvd.dvd.mul_right (Int.natCast_dvd_natCast.mpr B.d₁_dvd) _, dvd_mul_right _ _⟩

end Triang

/-! ### The quotient `A/ℤ[α]` -/

/-- Auxiliary: `G ⧸ H ≃+ Q` if `f : P ↠ G`, `g : P ↠ Q` and `f n ∈ H ↔ g n = 0`. -/
noncomputable def quotEquivOf {P G Q : Type*} [AddCommGroup P] [AddCommGroup G] [AddCommGroup Q]
    (H : AddSubgroup G) (f : P →+ G) (hf : Function.Surjective f) (g : P →+ Q)
    (hg : Function.Surjective g) (hker : ∀ n, f n ∈ H ↔ g n = 0) : G ⧸ H ≃+ Q :=
  let ψ : P →+ G ⧸ H := (QuotientAddGroup.mk' H).comp f
  have hψ : Function.Surjective ψ := (QuotientAddGroup.mk'_surjective H).comp hf
  have hk : ψ.ker = g.ker := by
    ext n
    rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_ker, ← hker]
    exact QuotientAddGroup.eq_zero_iff (f n)
  (QuotientAddGroup.quotientKerEquivOfSurjective ψ hψ).symm.trans
    ((QuotientAddGroup.quotientAddEquivOfEq hk).trans
      (QuotientAddGroup.quotientKerEquivOfSurjective g hg))

/-- n ↦ (n₁ mod a, n₂ mod b, n₃ mod c). -/
def red3 (a b c : ℕ) : (Fin 4 → ℤ) →+ ZMod a × ZMod b × ZMod c where
  toFun n := ((n 1 : ZMod a), (n 2 : ZMod b), (n 3 : ZMod c))
  map_zero' := by simp
  map_add' n m := by simp

theorem red3_surjective {a b c : ℕ} (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) :
    Function.Surjective (red3 a b c) := by
  have : NeZero a := ⟨ha.ne'⟩
  have : NeZero b := ⟨hb.ne'⟩
  have : NeZero c := ⟨hc.ne'⟩
  rintro ⟨x, y, z⟩
  refine ⟨![0, (x.val : ℤ), (y.val : ℤ), (z.val : ℤ)], ?_⟩
  simp [red3]

theorem red3_eq_zero_iff (a b c : ℕ) (n : Fin 4 → ℤ) :
    red3 a b c n = 0 ↔ (a : ℤ) ∣ n 1 ∧ (b : ℤ) ∣ n 2 ∧ (c : ℤ) ∣ n 3 := by
  simp only [red3, AddMonoidHom.coe_mk, ZeroHom.coe_mk, Prod.ext_iff, Prod.fst_zero,
    Prod.snd_zero, ZMod.intCast_zmod_eq_zero_iff_dvd]

/-- n ↦ (n₁ mod a, n₂ mod b). -/
def red2 (a b : ℕ) : (Fin 4 → ℤ) →+ ZMod a × ZMod b where
  toFun n := ((n 1 : ZMod a), (n 2 : ZMod b))
  map_zero' := by simp
  map_add' n m := by simp

theorem red2_surjective {a b : ℕ} (ha : 0 < a) (hb : 0 < b) :
    Function.Surjective (red2 a b) := by
  have : NeZero a := ⟨ha.ne'⟩
  have : NeZero b := ⟨hb.ne'⟩
  rintro ⟨x, y⟩
  refine ⟨![0, (x.val : ℤ), (y.val : ℤ), 0], ?_⟩
  simp [red2]

theorem red2_eq_zero_iff (a b : ℕ) (n : Fin 4 → ℤ) :
    red2 a b n = 0 ↔ (a : ℤ) ∣ n 1 ∧ (b : ℤ) ∣ n 2 := by
  simp only [red2, AddMonoidHom.coe_mk, ZeroHom.coe_mk, Prod.ext_iff, Prod.fst_zero,
    Prod.snd_zero, ZMod.intCast_zmod_eq_zero_iff_dvd]

namespace Triang

variable {M : AddSubgroup (Fin 4 → ℚ)} (B : Triang M)

/-- `M/ℤ[α] ≅ ℤ/d₁ × ℤ/d₂ × ℤ/d₃`. -/
noncomputable def quotient_equiv :
    (M ⧸ Z4.addSubgroupOf M) ≃+ ZMod B.d₁ × ZMod B.d₂ × ZMod B.d₃ :=
  quotEquivOf _ B.combHom B.combHom_surjective (red3 B.d₁ B.d₂ B.d₃)
    (red3_surjective B.d₁_pos B.d₂_pos B.d₃_pos) (fun n => by
      rw [AddSubgroup.mem_addSubgroupOf, red3_eq_zero_iff]
      exact B.comb_mem_Z4_iff n)

/-- With `d₁ = 1`, `A/ℤ[α] ≅ ℤ/d₂ × ℤ/d₃`. -/
theorem quotient_equiv_T1 (h1 : B.d₁ = 1) :
    Nonempty ((M ⧸ Z4.addSubgroupOf M) ≃+ ZMod B.d₂ × ZMod B.d₃) := by
  have e := B.quotient_equiv
  rw [h1] at e
  exact ⟨e.trans AddEquiv.uniqueProd⟩

/-- [A : ℤ[α]] = d₁ d₂ d₃. -/
theorem index_eq : (Z4.addSubgroupOf M).index = B.d₁ * B.d₂ * B.d₃ := by
  rw [AddSubgroup.index, Nat.card_congr B.quotient_equiv.toEquiv, Nat.card_prod, Nat.card_prod,
    Nat.card_zmod, Nat.card_zmod, Nat.card_zmod, mul_assoc]

/-! ### [A ∩ V₂ : L₂] = d₂ -/

/-- `n ↦ n₀ + n₁ω₁ + n₂ω₂ ∈ M ∩ V₂` (`n₃` is ignored). -/
def combHom2 : (Fin 4 → ℤ) →+ (M ⊓ V2 : AddSubgroup (Fin 4 → ℚ)) where
  toFun n := ⟨B.comb ![n 0, n 1, n 2, 0], AddSubgroup.mem_inf.mpr ⟨B.comb_mem _, by
    show B.comb _ 3 = 0
    rw [B.comb_apply_three]; simp⟩⟩
  map_zero' := by
    apply Subtype.ext
    show B.comb _ = 0
    rw [← B.comb_zero]; congr 1; funext i; fin_cases i <;> rfl
  map_add' n m := by
    apply Subtype.ext
    show B.comb _ = B.comb _ + B.comb _
    rw [← B.comb_add]; congr 1; funext i; fin_cases i <;> simp

theorem combHom2_surjective : Function.Surjective B.combHom2 := by
  rintro ⟨x, hx⟩
  obtain ⟨hxM, hx3⟩ := AddSubgroup.mem_inf.mp hx
  obtain ⟨n, hn3, rfl⟩ := B.inter_V2 hxM hx3
  refine ⟨n, Subtype.ext ?_⟩
  show B.comb _ = B.comb _
  congr 1; funext i; fin_cases i <;> simp [hn3]

/-- (M ∩ V₂)/L₂ ≅ ℤ/d₁ × ℤ/d₂. -/
noncomputable def quotient_equiv_V2 :
    ((M ⊓ V2 : AddSubgroup (Fin 4 → ℚ)) ⧸ L2.addSubgroupOf (M ⊓ V2)) ≃+ ZMod B.d₁ × ZMod B.d₂ :=
  quotEquivOf _ B.combHom2 B.combHom2_surjective (red2 B.d₁ B.d₂)
    (red2_surjective B.d₁_pos B.d₂_pos) (fun n => by
      rw [AddSubgroup.mem_addSubgroupOf, red2_eq_zero_iff]
      show B.comb _ ∈ Z4 ⊓ V2 ↔ _
      rw [AddSubgroup.mem_inf, B.comb_mem_Z4_iff]
      have h3 : B.comb ![n 0, n 1, n 2, 0] ∈ V2 := by
        show B.comb _ 3 = 0
        rw [B.comb_apply_three]; simp
      simp [h3])

/-- [A ∩ V₂ : L₂] = d₁ d₂. -/
theorem index_V2_eq : (L2.addSubgroupOf (M ⊓ V2)).index = B.d₁ * B.d₂ := by
  rw [AddSubgroup.index, Nat.card_congr B.quotient_equiv_V2.toEquiv, Nat.card_prod,
    Nat.card_zmod, Nat.card_zmod]

/-- With `d₁ = 1`, `d₂ = [A ∩ V₂ : L₂]`. -/
theorem index_V2 (h1 : B.d₁ = 1) : (L2.addSubgroupOf (M ⊓ V2)).index = B.d₂ := by
  rw [B.index_V2_eq, h1, one_mul]

end Triang

/-! ### The five conditions -/

/-- 1·c₀ + α·c₁ + α²·c₂ + ω·c₃. -/
def lin (ω : Fin 4 → ℚ) (c : Fin 4 → ℤ) : Fin 4 → ℚ :=
  c 0 • apow 0 + c 1 • apow 1 + c 2 • apow 2 + c 3 • ω

/-- (i): `{1, α, α², ω}` is a `ℤ`-basis of `M` (`ω ∈ M` and unique integer coordinates). -/
def BasisWith (M : AddSubgroup (Fin 4 → ℚ)) (ω : Fin 4 → ℚ) : Prop :=
  ω ∈ M ∧ ∀ x ∈ M, ∃! c : Fin 4 → ℤ, x = lin ω c

/-- (v): the set `{e ≥ 1 | eM ⊆ ℤ[α]}`. -/
def expSet (M : AddSubgroup (Fin 4 → ℚ)) : Set ℕ := {e | 1 ≤ e ∧ ∀ x ∈ M, e • x ∈ Z4}

theorem lin_apply_three (ω : Fin 4 → ℚ) (c : Fin 4 → ℤ) : lin ω c 3 = c 3 * ω 3 := by
  simp [lin]

theorem lin_apply_two (ω : Fin 4 → ℚ) (c : Fin 4 → ℤ) : lin ω c 2 = c 2 + c 3 * ω 2 := by
  simp [lin]

theorem lin_apply_one (ω : Fin 4 → ℚ) (c : Fin 4 → ℤ) : lin ω c 1 = c 1 + c 3 * ω 1 := by
  simp [lin]

theorem lin_apply_zero (ω : Fin 4 → ℚ) (c : Fin 4 → ℤ) : lin ω c 0 = c 0 + c 3 * ω 0 := by
  simp [lin]

theorem lin_injective {ω : Fin 4 → ℚ} (hω : ω 3 ≠ 0) : Function.Injective (lin ω) := by
  intro c c' h
  have c3 := congrFun h 3
  have c2 := congrFun h 2
  have c1 := congrFun h 1
  have c0 := congrFun h 0
  rw [lin_apply_three, lin_apply_three] at c3
  rw [lin_apply_two, lin_apply_two] at c2
  rw [lin_apply_one, lin_apply_one] at c1
  rw [lin_apply_zero, lin_apply_zero] at c0
  have e3 : (c 3 : ℚ) = c' 3 := mul_right_cancel₀ hω c3
  rw [e3] at c2 c1 c0
  have e2 : (c 2 : ℚ) = c' 2 := add_right_cancel c2
  have e1 : (c 1 : ℚ) = c' 1 := add_right_cancel c1
  have e0 : (c 0 : ℚ) = c' 0 := add_right_cancel c0
  funext i
  fin_cases i
  · exact_mod_cast e0
  · exact_mod_cast e1
  · exact_mod_cast e2
  · exact_mod_cast e3

namespace Triang

variable {M : AddSubgroup (Fin 4 → ℚ)} (B : Triang M)

include B in
/-- (i) ⇒ (ii). -/
theorem saturated_of_basis {ω : Fin 4 → ℚ} (hω : BasisWith M ω) : Saturated M := by
  have hne : ω 3 ≠ 0 := by
    intro h0
    obtain ⟨c, hc, -⟩ := hω.2 _ B.ω₃_mem
    have := congrFun hc 3
    rw [lin_apply_three, h0, mul_zero] at this
    simp [omega3] at this
    exact B.d₃_pos.ne' this
  intro x hx hx3
  obtain ⟨c, rfl, -⟩ := hω.2 x hx
  rw [lin_apply_three] at hx3
  have hc3 : (c 3 : ℚ) = 0 := (mul_eq_zero.mp hx3).resolve_right hne
  intro i
  fin_cases i
  · exact ⟨c 0, by simp [lin, hc3]⟩
  · exact ⟨c 1, by simp [lin, hc3]⟩
  · exact ⟨c 2, by simp [lin, hc3]⟩
  · exact ⟨0, by simp [lin, hc3]⟩

/-- (ii) ⇒ (iii). -/
theorem d₂_eq_one_of_saturated (hsat : Saturated M) : B.d₂ = 1 := by
  have h := hsat _ B.ω₂_mem (by simp [omega2])
  obtain ⟨k, hk⟩ := h 2
  have hk' : (k : ℚ) = ((1 : ℤ) : ℚ) / B.d₂ + ((0 : ℤ) : ℚ) := by
    rw [hk]; simp [omega2]
  have := dvd_of_cast_eq B.d₂_pos hk'
  exact Nat.dvd_one.mp (by exact_mod_cast this)

theorem d₁_eq_one_of_d₂ (h2 : B.d₂ = 1) : B.d₁ = 1 :=
  Nat.dvd_one.mp (h2 ▸ B.d₁_dvd)

/-- (iii) ⇒ (i), with `ω = ω₃`. -/
theorem basis_of_d₂_eq_one (h2 : B.d₂ = 1) : BasisWith M B.ω₃ := by
  have h1 := B.d₁_eq_one_of_d₂ h2
  have hne : B.ω₃ 3 ≠ 0 := by simp [ω₃, omega3, B.d₃_q]
  refine ⟨B.ω₃_mem, fun x hx => ?_⟩
  obtain ⟨n, rfl⟩ := B.span x hx
  refine ⟨![n 0 + n 1 * B.p₁₀ + n 2 * B.p₂₀, n 1 + n 2 * B.p₂₁, n 2, n 3], ?_,
    fun c hc => lin_injective hne (hc.symm.trans ?_)⟩ <;>
  · funext i
    fin_cases i <;> simp [lin, combOf, ω₃, omega1, omega2, omega3, h1, h2]

include B in
/-- (i) ⇔ (ii). -/
theorem T1_i_iff_ii : (∃ ω, BasisWith M ω) ↔ Saturated M :=
  ⟨fun ⟨_, h⟩ => B.saturated_of_basis h,
    fun h => ⟨B.ω₃, B.basis_of_d₂_eq_one (B.d₂_eq_one_of_saturated h)⟩⟩

/-- (ii) ⇔ (iii). -/
theorem T1_ii_iff_iii : Saturated M ↔ B.d₂ = 1 :=
  ⟨B.d₂_eq_one_of_saturated, fun h => B.saturated_of_basis (B.basis_of_d₂_eq_one h)⟩

/-- (iii) ⇔ (iv). -/
theorem T1_iii_iff_iv : B.d₂ = 1 ↔ IsAddCyclic (M ⧸ Z4.addSubgroupOf M) := by
  rw [B.quotient_equiv.isAddCyclic, AddGroup.isAddCyclic_prod_iff,
    AddGroup.isAddCyclic_prod_iff]
  simp only [Nat.card_prod, Nat.card_zmod, ZMod.instIsAddCyclic, true_and]
  constructor
  · intro h2
    rw [B.d₁_eq_one_of_d₂ h2, h2]
    exact ⟨Nat.coprime_one_left _, Nat.coprime_one_left _⟩
  · rintro ⟨h23, -⟩
    exact Nat.Coprime.eq_one_of_dvd h23 B.d₂_dvd

/-- min{e ≥ 1 : eM ⊆ ℤ[α]} = d₃. -/
theorem isLeast_expSet : IsLeast (expSet M) B.d₃ := by
  refine ⟨⟨B.d₃_pos, fun x hx => ?_⟩, fun e ⟨_, he⟩ => ?_⟩
  · obtain ⟨n, rfl⟩ := B.span x hx
    show B.d₃ • B.comb n ∈ Z4
    rw [← B.comb_nsmul, B.comb_mem_Z4_iff]
    simp only [Pi.smul_apply, nsmul_eq_mul]
    exact ⟨Dvd.dvd.mul_right (Int.natCast_dvd_natCast.mpr (B.d₁_dvd.trans B.d₂_dvd)) _,
      Dvd.dvd.mul_right (Int.natCast_dvd_natCast.mpr B.d₂_dvd) _, dvd_mul_right _ _⟩
  · obtain ⟨k, hk⟩ := he _ B.ω₃_mem 3
    have hk' : (k : ℚ) = ((e : ℤ) : ℚ) / B.d₃ + ((0 : ℤ) : ℚ) := by
      rw [hk]; simp [omega3]; ring
    have := dvd_of_cast_eq B.d₃_pos hk'
    exact Nat.le_of_dvd (by omega) (by exact_mod_cast this)

/-- (iii) ⇔ (v). -/
theorem T1_iii_iff_v : B.d₂ = 1 ↔ IsLeast (expSet M) (Z4.addSubgroupOf M).index := by
  rw [B.index_eq]
  constructor
  · intro h2
    rw [B.d₁_eq_one_of_d₂ h2, h2, one_mul, one_mul]
    exact B.isLeast_expSet
  · intro h
    have h' := h.unique B.isLeast_expSet
    have : B.d₁ * B.d₂ = 1 := by
      have := B.d₃_pos
      have h'' : B.d₁ * B.d₂ * B.d₃ = 1 * B.d₃ := by rw [h', one_mul]
      exact Nat.eq_of_mul_eq_mul_right this h''
    exact Nat.dvd_one.mp ⟨B.d₁, by rw [← this, mul_comm]⟩

/-- `p ∣ d₂` iff `1, α, α²` are linearly dependent over `𝔽_p` in `A/pA`, that is, there are
    `c₀, c₁, c₂ ∈ ℤ`, not all divisible by `p`, with `c₀ + c₁α + c₂α² ∈ pA`. -/
theorem T1_mod_p {p : ℕ} (hp : p.Prime) :
    p ∣ B.d₂ ↔ ∃ c : Fin 3 → ℤ, ¬ (∀ i, (p : ℤ) ∣ c i) ∧
      ∃ y ∈ M, c 0 • apow 0 + c 1 • apow 1 + c 2 • apow 2 = p • y := by
  have hp0 : (p : ℚ) ≠ 0 := by exact_mod_cast hp.ne_zero
  constructor
  · rintro ⟨m, hm⟩
    have hm0 : (m : ℚ) ≠ 0 := by
      have := B.d₂_pos; rw [hm] at this; exact_mod_cast (Nat.pos_of_mul_pos_left this).ne'
    refine ⟨![B.p₂₀, B.p₂₁, 1], fun h => ?_, (m : ℤ) • B.ω₂, M.zsmul_mem B.ω₂_mem _, ?_⟩
    · have h2 := h 2
      simp only [Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons] at h2
      exact hp.one_lt.ne' (Nat.dvd_one.mp (by exact_mod_cast h2))
    · funext i
      fin_cases i <;> simp [ω₂, omega2, hm] <;> field_simp
  · rintro ⟨c, hc, y, hy, heq⟩
    by_contra hnd
    have hy3 : y 3 = 0 := by
      have := congrFun heq 3
      simp at this
      exact this.resolve_left hp.ne_zero
    have hd2y := B.d₂_smul_mem hy hy3
    have hpy : (p : ℤ) • y ∈ Z4 := by
      rw [natCast_zsmul, ← heq]
      intro i
      fin_cases i
      · exact ⟨c 0, by simp⟩
      · exact ⟨c 1, by simp⟩
      · exact ⟨c 2, by simp⟩
      · exact ⟨0, by simp⟩
    have hcop : Nat.gcd p B.d₂ = 1 := (Nat.Prime.coprime_iff_not_dvd hp).mpr hnd
    have huv := Nat.gcd_eq_gcd_ab p B.d₂
    rw [hcop, Nat.cast_one] at huv
    set u := Nat.gcdA p B.d₂
    set v := Nat.gcdB p B.d₂
    have hyZ : y ∈ Z4 := by
      have : y = u • ((p : ℤ) • y) + v • ((B.d₂ : ℤ) • y) := by
        rw [smul_smul, smul_smul, ← add_smul, mul_comm u, mul_comm v, ← huv, one_smul]
      rw [this]
      exact Z4.add_mem (Z4.zsmul_mem hpy u) (Z4.zsmul_mem hd2y v)
    apply hc
    intro i
    fin_cases i
    · obtain ⟨k, hk⟩ := hyZ 0
      have := congrFun heq 0
      simp only [Pi.add_apply, Pi.smul_apply, Pi.single_apply] at this
      simp at this
      rw [← hk] at this
      exact ⟨k, by exact_mod_cast this⟩
    · obtain ⟨k, hk⟩ := hyZ 1
      have := congrFun heq 1
      simp at this
      rw [← hk] at this
      exact ⟨k, by exact_mod_cast this⟩
    · obtain ⟨k, hk⟩ := hyZ 2
      have := congrFun heq 2
      simp at this
      rw [← hk] at this
      exact ⟨k, by exact_mod_cast this⟩

/-- **The proposition**, for `M = A` with `d₁ = 1` (Louboutin 2020, Thm. 13):
    `A/ℤ[α] ≅ ℤ/d₂ × ℤ/d₃`, `d₂ = [A ∩ V₂ : L₂]`, (i)–(v) equivalent, and the clause modulo `p`. -/
theorem prop_T1 (h1 : B.d₁ = 1) :
    Nonempty ((M ⧸ Z4.addSubgroupOf M) ≃+ ZMod B.d₂ × ZMod B.d₃) ∧
    (L2.addSubgroupOf (M ⊓ V2)).index = B.d₂ ∧
    [∃ ω, BasisWith M ω, Saturated M, B.d₂ = 1, IsAddCyclic (M ⧸ Z4.addSubgroupOf M),
      IsLeast (expSet M) (Z4.addSubgroupOf M).index].TFAE ∧
    ∀ p : ℕ, p.Prime → (p ∣ B.d₂ ↔ ∃ c : Fin 3 → ℤ, ¬ (∀ i, (p : ℤ) ∣ c i) ∧
      ∃ y ∈ M, c 0 • apow 0 + c 1 • apow 1 + c 2 • apow 2 = p • y) := by
  refine ⟨B.quotient_equiv_T1 h1, B.index_V2 h1, ?_, fun p hp => B.T1_mod_p hp⟩
  tfae_have 1 ↔ 2 := B.T1_i_iff_ii
  tfae_have 2 ↔ 3 := B.T1_ii_iff_iii
  tfae_have 3 ↔ 4 := B.T1_iii_iff_iv
  tfae_have 3 ↔ 5 := B.T1_iii_iff_v
  tfae_finish

end Triang

/-! ### Non-vacuity: every datum (`d₁ ∣ d₂ ∣ d₃`, `P_k`) is realized -/

/-- `combOf` as a homomorphism. -/
def combOfHom (ω₁ ω₂ ω₃ : Fin 4 → ℚ) : (Fin 4 → ℤ) →+ (Fin 4 → ℚ) where
  toFun := combOf ω₁ ω₂ ω₃
  map_zero' := by simp [combOf]
  map_add' n m := by simp only [combOf, Pi.add_apply, add_smul]; abel

/-- For every `0 < d₁ ∣ d₂ ∣ d₃` and `P_k`, the `ℤ`-module generated by `1, ω₁, ω₂, ω₃` carries
    a `Triang` structure: the hypotheses of `Triang` are not contradictory, for any `d₂`. -/
def Triang.ofData (d₁ d₂ d₃ : ℕ) (h₁ : 0 < d₁) (h₂ : 0 < d₂) (h₃ : 0 < d₃) (h₁₂ : d₁ ∣ d₂)
    (h₂₃ : d₂ ∣ d₃) (p₁₀ p₂₀ p₂₁ p₃₀ p₃₁ p₃₂ : ℤ) :
    Triang (combOfHom (omega1 d₁ p₁₀) (omega2 d₂ p₂₀ p₂₁) (omega3 d₃ p₃₀ p₃₁ p₃₂)).range where
  d₁ := d₁
  d₂ := d₂
  d₃ := d₃
  d₁_pos := h₁
  d₂_pos := h₂
  d₃_pos := h₃
  d₁_dvd := h₁₂
  d₂_dvd := h₂₃
  p₁₀ := p₁₀
  p₂₀ := p₂₀
  p₂₁ := p₂₁
  p₃₀ := p₃₀
  p₃₁ := p₃₁
  p₃₂ := p₃₂
  one_mem := ⟨![1, 0, 0, 0], by simp [combOfHom, combOf]⟩
  ω₁_mem := ⟨![0, 1, 0, 0], by simp [combOfHom, combOf]⟩
  ω₂_mem := ⟨![0, 0, 1, 0], by simp [combOfHom, combOf]⟩
  ω₃_mem := ⟨![0, 0, 0, 1], by simp [combOfHom, combOf]⟩
  span := fun _ ⟨n, hn⟩ => ⟨n, hn.symm⟩

end Louboutin
