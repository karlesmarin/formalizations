/-! ### Determinants (Lemma 1.3) -/

section det
variable {R : Type*} [CommRing R]

theorem det4 (A : Matrix (Fin 4) (Fin 4) R) :
    A.det = det4e (A 0 0) (A 0 1) (A 0 2) (A 0 3) (A 1 0) (A 1 1) (A 1 2) (A 1 3)
      (A 2 0) (A 2 1) (A 2 2) (A 2 3) (A 3 0) (A 3 1) (A 3 2) (A 3 3) := by
  rw [Matrix.det_succ_row_zero]
  simp [Fin.sum_univ_succ, Matrix.det_fin_three, Fin.succAbove, det4e, Matrix.submatrix]
  ring

theorem vand4 (x : Fin 4 → R) : (vandermonde x).det = Vand x := by
  rw [det_vandermonde]
  simp [Fin.prod_univ_succ, Fin.prod_Ioi_succ, Vand]
  ring

/-- **Lemma 1.3**: if column l has conjugates E i l = Σ_k c_lk x_iᵏ (c integral), then
    det E = Vand · det c. -/
theorem det_coord (x : Fin 4 → R) (E : Matrix (Fin 4) (Fin 4) R) (c : Matrix (Fin 4) (Fin 4) ℤ)
    (hE : ∀ i l, E i l = ∑ k : Fin 4, (c l k : R) * x i ^ (k : ℕ)) :
    E.det = Vand x * ((c.det : ℤ) : R) := by
  have hE' : E = vandermonde x * (c.map (Int.castRingHom R))ᵀ := by
    ext i l
    rw [hE, Matrix.mul_apply]
    simp [vandermonde_apply, mul_comm]
  rw [hE', det_mul, det_transpose, vand4]
  congr 1
  rw [show ((c.det : ℤ) : R) = Int.castRingHom R c.det from rfl, RingHom.map_det]
  rfl

end det

/-! ### Integer bookkeeping (the ℤ[X] Gauss step) -/

theorem prim_lin {n t : ℤ} (h : IsCoprime n t) : (C n * X + C t).IsPrimitive := by
  intro r hr
  rw [C_dvd_iff_dvd_coeff] at hr
  have h1 := hr 1
  have h0 := hr 0
  rw [coeff_add, coeff_C_mul_X, coeff_C] at h1 h0
  simp at h1 h0
  exact h.isUnit_of_dvd' h1 h0

/-- Gauss for primitive polynomials over ℤ: if g divides every coefficient of
    θ·∏_j (n_j X + t_j) with gcd(n_j, t_j) = 1, then g ∣ θ. -/
theorem gauss3 {g θ n₁ n₂ n₃ t₁ t₂ t₃ : ℤ} (h₁ : IsCoprime n₁ t₁) (h₂ : IsCoprime n₂ t₂)
    (h₃ : IsCoprime n₃ t₃) (hu : g ∣ θ * (n₁ * n₂ * n₃))
    (hv : g ∣ θ * (n₁ * n₂ * t₃ + n₁ * t₂ * n₃ + t₁ * n₂ * n₃))
    (hw : g ∣ θ * (n₁ * t₂ * t₃ + t₁ * n₂ * t₃ + t₁ * t₂ * n₃))
    (ht : g ∣ θ * (t₁ * t₂ * t₃)) : g ∣ θ := by
  set F : ℤ[X] := (C n₁ * X + C t₁) * (C n₂ * X + C t₂) * (C n₃ * X + C t₃) with hFdef
  have hF : F.IsPrimitive := ((prim_lin h₁).mul (prim_lin h₂)).mul (prim_lin h₃)
  have hexp : C θ * F = C (θ * (n₁ * n₂ * n₃)) * X ^ 3
      + C (θ * (n₁ * n₂ * t₃ + n₁ * t₂ * n₃ + t₁ * n₂ * n₃)) * X ^ 2
      + C (θ * (n₁ * t₂ * t₃ + t₁ * n₂ * t₃ + t₁ * t₂ * n₃)) * X + C (θ * (t₁ * t₂ * t₃)) := by
    simp only [hFdef, map_mul, map_add]; ring
  have hdvd : C g ∣ C θ * F := by
    rw [hexp]
    exact dvd_add (dvd_add (dvd_add ((map_dvd C hu).mul_right _) ((map_dvd C hv).mul_right _))
      ((map_dvd C hw).mul_right _)) (map_dvd C ht)
  have := (dvd_content_iff_C_dvd).mpr hdvd
  rw [content_C_mul, hF.content_eq_one, mul_one] at this
  exact dvd_normalize_iff.mp this

/-! ### The model -/

/-- V4 data: conjugates `x`, the three nontrivial automorphisms in the XOR labelling, and
    "invariant ⇒ integer". -/
structure V4Data (O : Type*) [CommRing O] where
  x : Fin 4 → O
  τ₁ : O →+* O
  τ₂ : O →+* O
  τ₃ : O →+* O
  h₁ : τ₁ (x 0) = x 1 ∧ τ₁ (x 1) = x 0 ∧ τ₁ (x 2) = x 3 ∧ τ₁ (x 3) = x 2
  h₂ : τ₂ (x 0) = x 2 ∧ τ₂ (x 1) = x 3 ∧ τ₂ (x 2) = x 0 ∧ τ₂ (x 3) = x 1
  h₃ : τ₃ (x 0) = x 3 ∧ τ₃ (x 1) = x 2 ∧ τ₃ (x 2) = x 1 ∧ τ₃ (x 3) = x 0
  fix : ∀ y, τ₁ y = y → τ₂ y = y → τ₃ y = y → ∃ n : ℤ, y = n
  inj : Function.Injective x

namespace V4Data

variable {O : Type*} [CommRing O] [IsDomain O] [CharZero O] (M : V4Data O)

/-- ℤ[α] = ℤ + ℤα + ℤα² + ℤα³ inside O. -/
def Zα : Submodule ℤ O := Submodule.span ℤ (Set.range fun k : Fin 4 => M.x 0 ^ (k : ℕ))

/-- the four elements of V4 as ring maps, row i = σ_i (σ_0 = id). -/
def ρ (i : Fin 4) : O →+* O := ![RingHom.id O, M.τ₁, M.τ₂, M.τ₃] i

theorem ρ_x0 (i : Fin 4) : M.ρ i (M.x 0) = M.x i := by
  fin_cases i <;> simp [ρ, M.h₁.1, M.h₂.1, M.h₃.1]

/-- Saturation: O ∩ ℚ = ℤ in the form g·y = n ⇒ g ∣ n. -/
theorem forall4 {P : Fin 4 → Prop} (h0 : P 0) (h1 : P 1) (h2 : P 2) (h3 : P 3) : ∀ i, P i := by
  intro i; fin_cases i <;> assumption

include M in
/-- Saturation, O ∩ ℚ = ℤ in the form n = g·y ⇒ g ∣ n (g ≠ 0). -/
theorem sat {n g : ℤ} {y : O} (hg : g ≠ 0) (h : (n : O) = g * y) : g ∣ n := by
  have hg' : (g : O) ≠ 0 := Int.cast_ne_zero.mpr hg
  have inv : ∀ σ : O →+* O, σ y = y := by
    intro σ
    apply mul_left_cancel₀ hg'
    calc (g : O) * σ y = σ ((g : O) * y) := by rw [map_mul, map_intCast]
      _ = σ (n : O) := by rw [h]
      _ = (g : O) * y := by rw [map_intCast, h]
  obtain ⟨m, hm⟩ := M.fix y (inv _) (inv _) (inv _)
  refine ⟨m, ?_⟩
  have : (n : O) = ((g * m : ℤ) : O) := by rw [h, hm]; push_cast; ring
  exact_mod_cast this

include M in
/-- If n = θ·y in O with n, θ integers, then θ ∣ n in ℤ (θ = 0 allowed). -/
theorem dvd_of_eq_mul {n θ : ℤ} {y : O} (h : (n : O) = θ * y) : θ ∣ n := by
  rcases eq_or_ne θ 0 with rfl | hθ
  · have h0 : (n : O) = 0 := by rw [h]; simp
    have : n = 0 := by exact_mod_cast h0
    simp [this]
  · exact M.sat hθ h

theorem Vand_ne_zero : Vand M.x ≠ 0 := by
  have h : ∀ i j : Fin 4, i ≠ j → M.x j - M.x i ≠ 0 := fun i j hij =>
    sub_ne_zero.mpr (M.inj.ne hij.symm)
  simp only [Vand]
  refine mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero ?_ ?_) ?_) ?_) ?_) ?_ <;>
    exact h _ _ (by decide)

