/-- **Theorem 2** (proof of Theorem A), unconditional: any integer g dividing T, U, V and W
    divides the twelve Cramer numerators N_jk (which are integers). -/
theorem thm2 {g t u v w : ℤ} (ht : T M.x = t) (hu : U M.x = u) (hv : V M.x = v) (hw : W M.x = w)
    (hg : g ∣ t ∧ g ∣ u ∧ g ∣ v ∧ g ∣ w) :
    (∃ n : ℤ, N10 M.x = n ∧ g ∣ n) ∧
    (∃ n : ℤ, N11 M.x = n ∧ g ∣ n) ∧
    (∃ n : ℤ, N12 M.x = n ∧ g ∣ n) ∧
    (∃ n : ℤ, N13 M.x = n ∧ g ∣ n) ∧
    (∃ n : ℤ, N20 M.x = n ∧ g ∣ n) ∧
    (∃ n : ℤ, N21 M.x = n ∧ g ∣ n) ∧
    (∃ n : ℤ, N22 M.x = n ∧ g ∣ n) ∧
    (∃ n : ℤ, N23 M.x = n ∧ g ∣ n) ∧
    (∃ n : ℤ, N30 M.x = n ∧ g ∣ n) ∧
    (∃ n : ℤ, N31 M.x = n ∧ g ∣ n) ∧
    (∃ n : ℤ, N32 M.x = n ∧ g ∣ n) ∧
    (∃ n : ℤ, N33 M.x = n ∧ g ∣ n) := by
  obtain ⟨a1, b1, a2, b2, a3, b3⟩ := M.sgn₁
  obtain ⟨c1, d1, c2, d2, c3, d3⟩ := M.sgn₂
  obtain ⟨f1, g1, f2, g2, f3, g3⟩ := M.sgn₃
  have p : (1 : O) * 1 = 1 := by ring
  have m : (-1 : O) * -1 = 1 := by ring
  obtain ⟨⟨A1, hA1⟩, ⟨B1, hB1⟩⟩ := M.pair_ints p m m a1 b1 c1 d1 f1 g1
  obtain ⟨⟨A2, hA2⟩, ⟨B2, hB2⟩⟩ := M.pair_ints m p m a2 b2 c2 d2 f2 g2
  obtain ⟨⟨A3, hA3⟩, ⟨B3, hB3⟩⟩ := M.pair_ints m m p a3 b3 c3 d3 f3 g3
  obtain ⟨n1, t1, cop1, ϑ1, hr1, hq1, u1, v1, hϑ1⟩ := split_pair hA1 hB1
  obtain ⟨n2, t2, cop2, ϑ2, hr2, hq2, u2, v2, hϑ2⟩ := split_pair hA2 hB2
  obtain ⟨n3, t3, cop3, ϑ3, hr3, hq3, u3, v3, hϑ3⟩ := split_pair hA3 hB3
  -- Θ = ϑ₁ϑ₂ϑ₃ is V4-invariant, hence an integer θ
  have s11 := lin_sign M.τ₁ u1 v1 a1 b1
  have s12 := lin_sign M.τ₁ u2 v2 a2 b2
  have s13 := lin_sign M.τ₁ u3 v3 a3 b3
  have s21 := lin_sign M.τ₂ u1 v1 c1 d1
  have s22 := lin_sign M.τ₂ u2 v2 c2 d2
  have s23 := lin_sign M.τ₂ u3 v3 c3 d3
  have s31 := lin_sign M.τ₃ u1 v1 f1 g1
  have s32 := lin_sign M.τ₃ u2 v2 f2 g2
  have s33 := lin_sign M.τ₃ u3 v3 f3 g3
  rw [← hϑ1] at s11 s21 s31
  rw [← hϑ2] at s12 s22 s32
  rw [← hϑ3] at s13 s23 s33
  obtain ⟨θ, hθ⟩ := M.fix (ϑ1 * ϑ2 * ϑ3) (by rw [map_mul, map_mul, s11, s12, s13]; ring)
    (by rw [map_mul, map_mul, s21, s22, s23]; ring) (by rw [map_mul, map_mul, s31, s32, s33]; ring)
  -- P = θ · ∏ (n_j X + t_j): the four coefficients
  have eu : (u : O) = ((θ * (n1 * n2 * n3) : ℤ) : O) := by
    rw [← hu, U_eq, hr1, hr2, hr3]; push_cast; rw [← hθ]; ring
  have ev : (v : O) = ((θ * (n1 * n2 * t3 + n1 * t2 * n3 + t1 * n2 * n3) : ℤ) : O) := by
    rw [← hv, V_eq, hr1, hr2, hr3, hq1, hq2, hq3]; push_cast; rw [← hθ]; ring
  have ew : (w : O) = ((θ * (n1 * t2 * t3 + t1 * n2 * t3 + t1 * t2 * n3) : ℤ) : O) := by
    rw [← hw, W_eq, hr1, hr2, hr3, hq1, hq2, hq3]; push_cast; rw [← hθ]; ring
  have et : (t : O) = ((θ * (t1 * t2 * t3) : ℤ) : O) := by
    rw [← ht, T_eq, hq1, hq2, hq3]; push_cast; rw [← hθ]; ring
  have eu' : u = θ * (n1 * n2 * n3) := by exact_mod_cast eu
  have ev' : v = θ * (n1 * n2 * t3 + n1 * t2 * n3 + t1 * n2 * n3) := by exact_mod_cast ev
  have ew' : w = θ * (n1 * t2 * t3 + t1 * n2 * t3 + t1 * t2 * n3) := by exact_mod_cast ew
  have et' : t = θ * (t1 * t2 * t3) := by exact_mod_cast et
  obtain ⟨hgt, hgu, hgv, hgw⟩ := hg
  have hgθ : g ∣ θ := gauss3 cop1 cop2 cop3 (eu' ▸ hgu) (ev' ▸ hgv) (ew' ▸ hgw) (et' ▸ hgt)
  -- each N_jk = θ · (element of O), and N_jk ∈ ℤ
  have hsc := Nc_scale M.x (n1 : O) n2 n3 t1 t2 t3 ϑ1 ϑ2 ϑ3
  have fin : ∀ (Nv : O) (y : O), (∃ n : ℤ, Nv = n) → Nv = (θ : O) * y → ∃ n : ℤ, Nv = n ∧ g ∣ n := by
    rintro Nv y ⟨n, hn⟩ he
    exact ⟨n, hn, dvd_trans hgθ (M.dvd_of_eq_mul (y := y) (by rw [← hn, he]))⟩
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact fin _ (Nc10 M.x (n1 : O) n2 n3 t1 t2 t3) M.N10_int
      (by rw [N10, hr1, hr2, hr3, hq1, hq2, hq3, hsc.1, hθ])
  · exact fin _ (Nc11 M.x (n1 : O) n2 n3 t1 t2 t3) M.N11_int
      (by rw [N11, hr1, hr2, hr3, hq1, hq2, hq3, hsc.2.1, hθ])
  · exact fin _ (Nc12 M.x (n1 : O) n2 n3 t1 t2 t3) M.N12_int
      (by rw [N12, hr1, hr2, hr3, hq1, hq2, hq3, hsc.2.2.1, hθ])
  · exact fin _ (Nc13 M.x (n1 : O) n2 n3 t1 t2 t3) M.N13_int
      (by rw [N13, hr1, hr2, hr3, hq1, hq2, hq3, hsc.2.2.2.1, hθ])
  · exact fin _ (Nc20 M.x (n1 : O) n2 n3 t1 t2 t3) M.N20_int
      (by rw [N20, hr1, hr2, hr3, hq1, hq2, hq3, hsc.2.2.2.2.1, hθ])
  · exact fin _ (Nc21 M.x (n1 : O) n2 n3 t1 t2 t3) M.N21_int
      (by rw [N21, hr1, hr2, hr3, hq1, hq2, hq3, hsc.2.2.2.2.2.1, hθ])
  · exact fin _ (Nc22 M.x (n1 : O) n2 n3 t1 t2 t3) M.N22_int
      (by rw [N22, hr1, hr2, hr3, hq1, hq2, hq3, hsc.2.2.2.2.2.2.1, hθ])
  · exact fin _ (Nc23 M.x (n1 : O) n2 n3 t1 t2 t3) M.N23_int
      (by rw [N23, hr1, hr2, hr3, hq1, hq2, hq3, hsc.2.2.2.2.2.2.2.1, hθ])
  · exact fin _ (Nc30 M.x (n1 : O) n2 n3 t1 t2 t3) M.N30_int
      (by rw [N30, hr1, hr2, hr3, hq1, hq2, hq3, hsc.2.2.2.2.2.2.2.2.1, hθ])
  · exact fin _ (Nc31 M.x (n1 : O) n2 n3 t1 t2 t3) M.N31_int
      (by rw [N31, hr1, hr2, hr3, hq1, hq2, hq3, hsc.2.2.2.2.2.2.2.2.2.1, hθ])
  · exact fin _ (Nc32 M.x (n1 : O) n2 n3 t1 t2 t3) M.N32_int
      (by rw [N32, hr1, hr2, hr3, hq1, hq2, hq3, hsc.2.2.2.2.2.2.2.2.2.2.1, hθ])
  · exact fin _ (Nc33 M.x (n1 : O) n2 n3 t1 t2 t3) M.N33_int
      (by rw [N33, hr1, hr2, hr3, hq1, hq2, hq3, hsc.2.2.2.2.2.2.2.2.2.2.2, hθ])

/-- **Θ-factorisation** (the S4 prefix of `thm2`, stated on its own): coprime pairs
    (n_j, t_j), elements ϑ_j ∈ O with r_j = n_j ϑ_j, ΔQ_j = t_j ϑ_j, and an integer θ = ϑ₁ϑ₂ϑ₃
    with P(X) = θ·∏(n_j X + t_j): U, V, W, T are θ times the coefficients of the primitive
    polynomial ∏(n_j X + t_j). -/
theorem theta_factor {t u v w : ℤ} (ht : T M.x = t) (hu : U M.x = u) (hv : V M.x = v)
    (hw : W M.x = w) :
    ∃ n1 n2 n3 t1 t2 t3 θ : ℤ, IsCoprime n1 t1 ∧ IsCoprime n2 t2 ∧ IsCoprime n3 t3 ∧
      (∃ ϑ1 ϑ2 ϑ3 : O, r1 M.x = n1 * ϑ1 ∧ dQ1 M.x = t1 * ϑ1 ∧ r2 M.x = n2 * ϑ2 ∧
        dQ2 M.x = t2 * ϑ2 ∧ r3 M.x = n3 * ϑ3 ∧ dQ3 M.x = t3 * ϑ3 ∧ (θ : O) = ϑ1 * ϑ2 * ϑ3) ∧
      u = θ * (n1 * n2 * n3) ∧
      v = θ * (n1 * n2 * t3 + n1 * t2 * n3 + t1 * n2 * n3) ∧
      w = θ * (n1 * t2 * t3 + t1 * n2 * t3 + t1 * t2 * n3) ∧
      t = θ * (t1 * t2 * t3) := by
  obtain ⟨a1, b1, a2, b2, a3, b3⟩ := M.sgn₁
  obtain ⟨c1, d1, c2, d2, c3, d3⟩ := M.sgn₂
  obtain ⟨f1, g1, f2, g2, f3, g3⟩ := M.sgn₃
  have p : (1 : O) * 1 = 1 := by ring
  have m : (-1 : O) * -1 = 1 := by ring
  obtain ⟨⟨A1, hA1⟩, ⟨B1, hB1⟩⟩ := M.pair_ints p m m a1 b1 c1 d1 f1 g1
  obtain ⟨⟨A2, hA2⟩, ⟨B2, hB2⟩⟩ := M.pair_ints m p m a2 b2 c2 d2 f2 g2
  obtain ⟨⟨A3, hA3⟩, ⟨B3, hB3⟩⟩ := M.pair_ints m m p a3 b3 c3 d3 f3 g3
  obtain ⟨n1, t1, cop1, ϑ1, hr1, hq1, u1, v1, hϑ1⟩ := split_pair hA1 hB1
  obtain ⟨n2, t2, cop2, ϑ2, hr2, hq2, u2, v2, hϑ2⟩ := split_pair hA2 hB2
  obtain ⟨n3, t3, cop3, ϑ3, hr3, hq3, u3, v3, hϑ3⟩ := split_pair hA3 hB3
  have s11 := lin_sign M.τ₁ u1 v1 a1 b1
  have s12 := lin_sign M.τ₁ u2 v2 a2 b2
  have s13 := lin_sign M.τ₁ u3 v3 a3 b3
  have s21 := lin_sign M.τ₂ u1 v1 c1 d1
  have s22 := lin_sign M.τ₂ u2 v2 c2 d2
  have s23 := lin_sign M.τ₂ u3 v3 c3 d3
  have s31 := lin_sign M.τ₃ u1 v1 f1 g1
  have s32 := lin_sign M.τ₃ u2 v2 f2 g2
  have s33 := lin_sign M.τ₃ u3 v3 f3 g3
  rw [← hϑ1] at s11 s21 s31
  rw [← hϑ2] at s12 s22 s32
  rw [← hϑ3] at s13 s23 s33
  obtain ⟨θ, hθ⟩ := M.fix (ϑ1 * ϑ2 * ϑ3) (by rw [map_mul, map_mul, s11, s12, s13]; ring)
    (by rw [map_mul, map_mul, s21, s22, s23]; ring) (by rw [map_mul, map_mul, s31, s32, s33]; ring)
  have eu : (u : O) = ((θ * (n1 * n2 * n3) : ℤ) : O) := by
    rw [← hu, U_eq, hr1, hr2, hr3]; push_cast; rw [← hθ]; ring
  have ev : (v : O) = ((θ * (n1 * n2 * t3 + n1 * t2 * n3 + t1 * n2 * n3) : ℤ) : O) := by
    rw [← hv, V_eq, hr1, hr2, hr3, hq1, hq2, hq3]; push_cast; rw [← hθ]; ring
  have ew : (w : O) = ((θ * (n1 * t2 * t3 + t1 * n2 * t3 + t1 * t2 * n3) : ℤ) : O) := by
    rw [← hw, W_eq, hr1, hr2, hr3, hq1, hq2, hq3]; push_cast; rw [← hθ]; ring
  have et : (t : O) = ((θ * (t1 * t2 * t3) : ℤ) : O) := by
    rw [← ht, T_eq, hq1, hq2, hq3]; push_cast; rw [← hθ]; ring
  exact ⟨n1, n2, n3, t1, t2, t3, θ, cop1, cop2, cop3,
    ⟨ϑ1, ϑ2, ϑ3, hr1, hq1, hr2, hq2, hr3, hq3, hθ.symm⟩,
    by exact_mod_cast eu, by exact_mod_cast ev, by exact_mod_cast ew, by exact_mod_cast et⟩

/-- **Content of P** (proof of Theorem A): θ = ϑ₁ϑ₂ϑ₃ (ϑ_j from `split_pair`, r_j = n_j ϑ_j,
    ΔQ_j = t_j ϑ_j with gcd(n_j, t_j) = 1) divides T, U, V, W, and every common divisor of
    T, U, V, W divides θ: θ is a gcd of (T, U, V, W). -/
theorem gcd_eq_abs_theta {t u v w : ℤ} (ht : T M.x = t) (hu : U M.x = u) (hv : V M.x = v)
    (hw : W M.x = w) :
    ∃ θ : ℤ, (θ ∣ t ∧ θ ∣ u ∧ θ ∣ v ∧ θ ∣ w) ∧
      (∀ g : ℤ, g ∣ t ∧ g ∣ u ∧ g ∣ v ∧ g ∣ w → g ∣ θ) ∧
      ∃ n1 n2 n3 t1 t2 t3 : ℤ, IsCoprime n1 t1 ∧ IsCoprime n2 t2 ∧ IsCoprime n3 t3 ∧
      ∃ ϑ1 ϑ2 ϑ3 : O, r1 M.x = n1 * ϑ1 ∧ dQ1 M.x = t1 * ϑ1 ∧ r2 M.x = n2 * ϑ2 ∧
        dQ2 M.x = t2 * ϑ2 ∧ r3 M.x = n3 * ϑ3 ∧ dQ3 M.x = t3 * ϑ3 ∧
        (θ : O) = ϑ1 * ϑ2 * ϑ3 := by
  obtain ⟨n1, n2, n3, t1, t2, t3, θ, cop1, cop2, cop3, hϑ, eu, ev, ew, et⟩ :=
    M.theta_factor ht hu hv hw
  refine ⟨θ, ⟨⟨_, et⟩, ⟨_, eu⟩, ⟨_, ev⟩, ⟨_, ew⟩⟩, ?_, n1, n2, n3, t1, t2, t3,
    cop1, cop2, cop3, hϑ⟩
  rintro g ⟨hgt, hgu, hgv, hgw⟩
  exact gauss3 cop1 cop2 cop3 (eu ▸ hgu) (ev ▸ hgv) (ew ▸ hgw) (et ▸ hgt)

/-- **gcd(T, U, V, W) = |Θ|** literally: `Int.gcd (Int.gcd t u) (Int.gcd v w) = |θ|`, with
    θ = ϑ₁ϑ₂ϑ₃ as in `gcd_eq_abs_theta`. -/
theorem gcd_TUVW {t u v w : ℤ} (ht : T M.x = t) (hu : U M.x = u) (hv : V M.x = v)
    (hw : W M.x = w) :
    ∃ θ : ℤ, ((Int.gcd (Int.gcd t u) (Int.gcd v w) : ℕ) : ℤ) = |θ| ∧
      Int.gcd (Int.gcd t u) (Int.gcd v w) = θ.natAbs ∧
      ∃ n1 n2 n3 t1 t2 t3 : ℤ, IsCoprime n1 t1 ∧ IsCoprime n2 t2 ∧ IsCoprime n3 t3 ∧
      ∃ ϑ1 ϑ2 ϑ3 : O, r1 M.x = n1 * ϑ1 ∧ dQ1 M.x = t1 * ϑ1 ∧ r2 M.x = n2 * ϑ2 ∧
        dQ2 M.x = t2 * ϑ2 ∧ r3 M.x = n3 * ϑ3 ∧ dQ3 M.x = t3 * ϑ3 ∧
        (θ : O) = ϑ1 * ϑ2 * ϑ3 := by
  obtain ⟨θ, ⟨dt, du, dv, dw⟩, hmax, hϑ⟩ := M.gcd_eq_abs_theta ht hu hv hw
  set G : ℤ := ((Int.gcd (Int.gcd t u) (Int.gcd v w) : ℕ) : ℤ) with hG
  have hGtu : G ∣ ((Int.gcd t u : ℕ) : ℤ) := Int.gcd_dvd_left ..
  have hGvw : G ∣ ((Int.gcd v w : ℕ) : ℤ) := Int.gcd_dvd_right ..
  have hGθ : G ∣ θ := hmax G ⟨hGtu.trans (Int.gcd_dvd_left t u),
    hGtu.trans (Int.gcd_dvd_right t u), hGvw.trans (Int.gcd_dvd_left v w),
    hGvw.trans (Int.gcd_dvd_right v w)⟩
  have hθG : θ ∣ G := Int.dvd_coe_gcd (Int.dvd_coe_gcd dt du) (Int.dvd_coe_gcd dv dw)
  have e : G = |θ| := Int.dvd_antisymm (Int.natCast_nonneg _) (abs_nonneg θ)
    ((dvd_abs G θ).mpr hGθ) ((abs_dvd θ G).mpr hθG)
  refine ⟨θ, e, ?_, hϑ⟩
  have h2 : G = ((θ.natAbs : ℕ) : ℤ) := by rw [Int.natCast_natAbs, e]
  exact Int.natCast_inj.mp h2

theorem mem_of_cramer {δ : ℤ} (hδ : Vand M.x = δ) {N0 N1 N2 N3 y : O}
    (h0 : ∃ n : ℤ, N0 = n ∧ δ ∣ n) (h1 : ∃ n : ℤ, N1 = n ∧ δ ∣ n)
    (h2 : ∃ n : ℤ, N2 = n ∧ δ ∣ n) (h3 : ∃ n : ℤ, N3 = n ∧ δ ∣ n)
    (hc : N0 + N1 * M.x 0 + N2 * M.x 0 ^ 2 + N3 * M.x 0 ^ 3 = Vand M.x * (M.x 0 + y)) :
    y ∈ M.Zα := by
  obtain ⟨_, e0, k0, rfl⟩ := h0
  obtain ⟨_, e1, k1, rfl⟩ := h1
  obtain ⟨_, e2, k2, rfl⟩ := h2
  obtain ⟨_, e3, k3, rfl⟩ := h3
  push_cast at e0 e1 e2 e3
  have hV : (δ : O) ≠ 0 := hδ ▸ M.Vand_ne_zero
  have hy : (δ : O) * (M.x 0 + y) = δ * (k0 + k1 * M.x 0 + k2 * M.x 0 ^ 2 + k3 * M.x 0 ^ 3) := by
    linear_combination (-1 : O) * hc + e0 + M.x 0 * e1 + M.x 0 ^ 2 * e2 + M.x 0 ^ 3 * e3
      - (M.x 0 + y) * hδ
  have hy' : y = (k0 : O) * M.x 0 ^ 0 + ((k1 - 1 : ℤ) : O) * M.x 0 ^ 1
      + (k2 : O) * M.x 0 ^ 2 + (k3 : O) * M.x 0 ^ 3 := by
    have := mul_left_cancel₀ hV hy
    push_cast
    linear_combination this
  have pm : ∀ k : ℕ, k < 4 → M.x 0 ^ k ∈ M.Zα := fun k hk => M.pow_mem ⟨k, hk⟩
  rw [hy']
  exact add_mem (add_mem (add_mem (M.intmul_mem _ (pm 0 (by norm_num)))
    (M.intmul_mem _ (pm 1 (by norm_num)))) (M.intmul_mem _ (pm 2 (by norm_num))))
    (M.intmul_mem _ (pm 3 (by norm_num)))

/-- **Conjecture 6.1 (Louboutin)**, in the V4 model: ℤ[α] is Galois-invariant (contains all
    conjugates) iff Δ = Vand divides T, U, V and W. -/
theorem conj61 {t u v w δ : ℤ} (ht : T M.x = t) (hu : U M.x = u) (hv : V M.x = v)
    (hw : W M.x = w) (hδ : Vand M.x = δ) :
    (∀ j, M.x j ∈ M.Zα) ↔ (δ ∣ t ∧ δ ∣ u ∧ δ ∣ v ∧ δ ∣ w) := by
  constructor
  · intro hx; exact M.nec hx ht hu hv hw hδ
  · intro hd
    have H := M.thm2 ht hu hv hw hd
    obtain ⟨h10, h11, h12, h13, h20, h21, h22, h23, h30, h31, h32, h33⟩ := H
    refine forall4 M.x0_mem ?_ ?_ ?_
    · exact M.mem_of_cramer hδ h10 h11 h12 h13 (cramer1 M.x).1
    · exact M.mem_of_cramer hδ h20 h21 h22 h23 (cramer2 M.x).1
    · exact M.mem_of_cramer hδ h30 h31 h32 h33 (cramer3 M.x).1

/-! #### Corollary `cor:weak`: Δ ∣ T, U, V ± W already forces Δ ∣ V, W

Route (the note's, without g ∣ Δ): `cross_prod` at r_j = n_jϑ_j, ΔQ_j = t_jϑ_j gives
θ²·d₁₂d₂₃d₃₁ = Δ·θ·n₁n₂n₃ (`theta_minors`). Write Δ = hG, θ = θ'G with gcd(h, θ') = 1; the
hypothesis gives h ∣ f₃, f₀, f₂ ± f₁ (f the coefficients of the primitive ∏(n_jX + t_j)), and
h ∣ d₁₂d₂₃d₃₁. If h were even, the mod-2 analysis of the three coprime pairs (`par_core`) makes
d₁₂d₂₃d₃₁ odd: contradiction. So h is odd, h ∣ 2f₂, 2f₁ gives h ∣ f₂, f₁, and Δ ∣ V, W. -/

/-- mod-2 core: three nonzero pairs (n_j, t_j) over 𝔽₂ with n₁n₂n₃ = 0, t₁t₂t₃ = 0 and
    f₂ + f₁ = 0 are the three points of ℙ¹(𝔽₂), so every minor d_ij is nonzero. -/
theorem par_core : ∀ n1 n2 n3 t1 t2 t3 : ZMod 2, ¬(n1 = 0 ∧ t1 = 0) → ¬(n2 = 0 ∧ t2 = 0) →
    ¬(n3 = 0 ∧ t3 = 0) → n1 * n2 * n3 = 0 → t1 * t2 * t3 = 0 →
    (n1 * n2 * t3 + n1 * t2 * n3 + t1 * n2 * n3) + (n1 * t2 * t3 + t1 * n2 * t3 + t1 * t2 * n3) = 0 →
    (n1 * t2 - n2 * t1) * (n2 * t3 - n3 * t2) * (n3 * t1 - n1 * t3) ≠ 0 := by
  decide

theorem two_dvd_iff_zmod (a : ℤ) : 2 ∣ a ↔ (a : ZMod 2) = 0 := by
  rw [ZMod.intCast_zmod_eq_zero_iff_dvd]; norm_num

theorem not_both_even {n t : ℤ} (h : IsCoprime n t) : ¬((n : ZMod 2) = 0 ∧ (t : ZMod 2) = 0) := by
  rintro ⟨hn, ht⟩
  rw [← two_dvd_iff_zmod] at hn ht
  have := h.isUnit_of_dvd' hn ht
  rw [Int.isUnit_iff] at this
  omega

/-- Integer form of `par_core`. -/
theorem par_int {n1 n2 n3 t1 t2 t3 : ℤ} (c1 : IsCoprime n1 t1) (c2 : IsCoprime n2 t2)
    (c3 : IsCoprime n3 t3) (h3 : 2 ∣ n1 * n2 * n3) (h0 : 2 ∣ t1 * t2 * t3)
    (h21 : 2 ∣ (n1 * n2 * t3 + n1 * t2 * n3 + t1 * n2 * n3) + (n1 * t2 * t3 + t1 * n2 * t3 + t1 * t2 * n3)) :
    ¬ 2 ∣ (n1 * t2 - n2 * t1) * (n2 * t3 - n3 * t2) * (n3 * t1 - n1 * t3) := by
  rw [two_dvd_iff_zmod] at h3 h0 h21 ⊢
  push_cast at h3 h0 h21 ⊢
  exact par_core _ _ _ _ _ _ (not_both_even c1) (not_both_even c2) (not_both_even c3) h3 h0 h21

/-- **Θ and the minors**: with the data of `theta_factor`, θ²·d₁₂d₂₃d₃₁ = Δ·θ·n₁n₂n₃,
    d_ij = n_i t_j − n_j t_i (`cross_prod` at r_j = n_jϑ_j, ΔQ_j = t_jϑ_j). -/
theorem theta_minors {t u v w δ : ℤ} (ht : T M.x = t) (hu : U M.x = u) (hv : V M.x = v)
    (hw : W M.x = w) (hδ : Vand M.x = δ) :
    ∃ n1 n2 n3 t1 t2 t3 θ : ℤ, IsCoprime n1 t1 ∧ IsCoprime n2 t2 ∧ IsCoprime n3 t3 ∧
      u = θ * (n1 * n2 * n3) ∧
      v = θ * (n1 * n2 * t3 + n1 * t2 * n3 + t1 * n2 * n3) ∧
      w = θ * (n1 * t2 * t3 + t1 * n2 * t3 + t1 * t2 * n3) ∧
      t = θ * (t1 * t2 * t3) ∧
      θ * θ * ((n1 * t2 - n2 * t1) * (n2 * t3 - n3 * t2) * (n3 * t1 - n1 * t3))
        = δ * θ * (n1 * n2 * n3) := by
  obtain ⟨n1, n2, n3, t1, t2, t3, θ, cop1, cop2, cop3,
    ⟨ϑ1, ϑ2, ϑ3, hr1, hq1, hr2, hq2, hr3, hq3, hθ⟩, eu, ev, ew, et⟩ := M.theta_factor ht hu hv hw
  refine ⟨n1, n2, n3, t1, t2, t3, θ, cop1, cop2, cop3, eu, ev, ew, et, ?_⟩
  have key := cross_prod M.x
  rw [hr1, hr2, hr3, hq1, hq2, hq3, hδ] at key
  have hO : ((θ * θ * ((n1 * t2 - n2 * t1) * (n2 * t3 - n3 * t2) * (n3 * t1 - n1 * t3)) : ℤ) : O)
      = ((δ * θ * (n1 * n2 * n3) : ℤ) : O) := by
    push_cast; rw [hθ]; linear_combination key
  exact_mod_cast hO

theorem split_gcd {δ θ : ℤ} (hδ : δ ≠ 0) :
    ∃ G h θ' : ℤ, G ≠ 0 ∧ IsCoprime h θ' ∧ δ = h * G ∧ θ = θ' * G := by
  refine ⟨(Int.gcd δ θ : ℤ), δ / (Int.gcd δ θ : ℤ), θ / (Int.gcd δ θ : ℤ), ?_,
    Int.isCoprime_iff_gcd_eq_one.mpr (Int.gcd_ediv_gcd_ediv_gcd_of_ne_zero_left hδ),
    (Int.ediv_mul_cancel (Int.gcd_dvd_left ..)).symm, (Int.ediv_mul_cancel (Int.gcd_dvd_right ..)).symm⟩
  exact_mod_cast (Int.gcd_pos_of_ne_zero_left θ hδ).ne'

/-- **Corollary `cor:weak`** (in the V4 model): if Δ = Vand divides T, U, V + W and V − W, then
    Δ divides T, U, V and W. -/
theorem cor_weak {t u v w δ : ℤ} (ht : T M.x = t) (hu : U M.x = u) (hv : V M.x = v)
    (hw : W M.x = w) (hδ : Vand M.x = δ) (hd : δ ∣ t ∧ δ ∣ u ∧ δ ∣ v + w ∧ δ ∣ v - w) :
    δ ∣ t ∧ δ ∣ u ∧ δ ∣ v ∧ δ ∣ w := by
  obtain ⟨dt, du, dvw, dvmw⟩ := hd
  refine ⟨dt, du, ?_⟩
  obtain ⟨n1, n2, n3, t1, t2, t3, θ, cop1, cop2, cop3, eu, ev, ew, et, hZ⟩ :=
    M.theta_minors ht hu hv hw hδ
  rcases eq_or_ne θ 0 with h0 | hθ0
  · subst h0; simp [ev, ew]
  have hδ0 : δ ≠ 0 := by rintro rfl; exact M.Vand_ne_zero (by simpa using hδ)
  obtain ⟨G, h, θ', hG0, hcop, rfl, rfl⟩ := split_gcd (θ := θ) hδ0
  have red : ∀ f : ℤ, h * G ∣ θ' * G * f → h ∣ f := by
    intro f hf
    have hf' : h * G ∣ (θ' * f) * G := by rw [show θ' * f * G = θ' * G * f by ring]; exact hf
    exact hcop.dvd_of_dvd_mul_left ((mul_dvd_mul_iff_right hG0).mp hf')
  have f3 := red _ (eu ▸ du)
  have f0 := red _ (et ▸ dt)
  have fp : h ∣ (n1 * n2 * t3 + n1 * t2 * n3 + t1 * n2 * n3) + (n1 * t2 * t3 + t1 * n2 * t3 + t1 * t2 * n3) :=
    red _ (by rw [ev, ew, ← mul_add] at dvw; exact dvw)
  have fm : h ∣ (n1 * n2 * t3 + n1 * t2 * n3 + t1 * n2 * n3) - (n1 * t2 * t3 + t1 * n2 * t3 + t1 * t2 * n3) :=
    red _ (by rw [ev, ew, ← mul_sub] at dvmw; exact dvmw)
  -- h ∣ d₁₂d₂₃d₃₁ from θ'·D = h·N
  have hD : h ∣ (n1 * t2 - n2 * t1) * (n2 * t3 - n3 * t2) * (n3 * t1 - n1 * t3) := by
    have hθ'0 : θ' * G ≠ 0 := hθ0
    have e : θ' * G * ((θ' * G) * ((n1 * t2 - n2 * t1) * (n2 * t3 - n3 * t2) * (n3 * t1 - n1 * t3)))
        = θ' * G * ((h * G) * (n1 * n2 * n3)) := by linear_combination hZ
    have e2 := mul_left_cancel₀ hθ'0 e
    have e3 : θ' * ((n1 * t2 - n2 * t1) * (n2 * t3 - n3 * t2) * (n3 * t1 - n1 * t3))
        = h * (n1 * n2 * n3) := by
      apply mul_right_cancel₀ hG0; linear_combination e2
    exact hcop.dvd_of_dvd_mul_left ⟨n1 * n2 * n3, by linear_combination e3⟩
  -- h is odd
  have hodd : Odd h := by
    rw [← Int.not_even_iff_odd, even_iff_two_dvd]
    intro h2
    exact par_int cop1 cop2 cop3 (h2.trans f3) (h2.trans f0) (h2.trans fp) (h2.trans hD)
  obtain ⟨k, hk⟩ := hodd
  have half : ∀ f : ℤ, h ∣ 2 * f → h ∣ f := by
    intro f hf
    have e : f = h * f - k * (2 * f) := by rw [hk]; ring
    rw [e]; exact dvd_sub (dvd_mul_right h f) (dvd_mul_of_dvd_right hf k)
  have f2 : h ∣ n1 * n2 * t3 + n1 * t2 * n3 + t1 * n2 * n3 := by
    apply half
    have e : 2 * (n1 * n2 * t3 + n1 * t2 * n3 + t1 * n2 * n3)
        = ((n1 * n2 * t3 + n1 * t2 * n3 + t1 * n2 * n3) + (n1 * t2 * t3 + t1 * n2 * t3 + t1 * t2 * n3))
          + ((n1 * n2 * t3 + n1 * t2 * n3 + t1 * n2 * n3) - (n1 * t2 * t3 + t1 * n2 * t3 + t1 * t2 * n3)) := by
      ring
    rw [e]; exact dvd_add fp fm
  have f1 : h ∣ n1 * t2 * t3 + t1 * n2 * t3 + t1 * t2 * n3 := by
    apply half
    have e : 2 * (n1 * t2 * t3 + t1 * n2 * t3 + t1 * t2 * n3)
        = ((n1 * n2 * t3 + n1 * t2 * n3 + t1 * n2 * n3) + (n1 * t2 * t3 + t1 * n2 * t3 + t1 * t2 * n3))
          - ((n1 * n2 * t3 + n1 * t2 * n3 + t1 * n2 * n3) - (n1 * t2 * t3 + t1 * n2 * t3 + t1 * t2 * n3)) := by
      ring
    rw [e]; exact dvd_sub fp fm
  obtain ⟨m2, hm2⟩ := f2
  obtain ⟨m1, hm1⟩ := f1
  exact ⟨⟨θ' * m2, by rw [ev, hm2]; ring⟩, ⟨θ' * m1, by rw [ew, hm1]; ring⟩⟩

/-- **Cor. `cor:weak` + Conj. 6.1**: ℤ[α] is Galois-invariant iff Δ divides T, U, V + W and
    V − W (Louboutin's necessary condition, Prop. 6.1, is sufficient). -/
theorem conj61_weak {t u v w δ : ℤ} (ht : T M.x = t) (hu : U M.x = u) (hv : V M.x = v)
    (hw : W M.x = w) (hδ : Vand M.x = δ) :
    (∀ j, M.x j ∈ M.Zα) ↔ (δ ∣ t ∧ δ ∣ u ∧ δ ∣ v + w ∧ δ ∣ v - w) := by
  rw [M.conj61 ht hu hv hw hδ]
  constructor
  · rintro ⟨a, b, c, d⟩; exact ⟨a, b, dvd_add c d, dvd_sub c d⟩
  · exact M.cor_weak ht hu hv hw hδ

end V4Data
end Louboutin.Conj61
