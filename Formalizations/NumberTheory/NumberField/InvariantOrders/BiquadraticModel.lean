/-- Lemma 1.2 in the model: T, U, V, W and Δ = Vand are integers; Δ ≠ 0 and Δ is even. -/
theorem exists_ints : ∃ t u v w δ : ℤ, T M.x = t ∧ U M.x = u ∧ V M.x = v ∧ W M.x = w ∧
    Vand M.x = δ ∧ δ ≠ 0 ∧ Even δ := by
  obtain ⟨a, ha⟩ := M.ea_int
  obtain ⟨b, hb⟩ := M.eb_int
  obtain ⟨c, hc⟩ := M.ec_int
  obtain ⟨d, hd⟩ := M.ed_int
  obtain ⟨k1, hk1⟩ := M.z1_int
  obtain ⟨k2, hk2⟩ := M.z2_int
  obtain ⟨k3, hk3⟩ := M.z3_int
  obtain ⟨δ, hδ, hev⟩ := Vand_even M.x hk1 hk2 hk3
  refine ⟨a ^ 2 * d - c ^ 2, a ^ 3 - 4 * a * b + 8 * c, a ^ 2 * b + 2 * a * c - 4 * b ^ 2 + 16 * d,
    a ^ 2 * c + 8 * a * d - 4 * b * c, δ, ?_, ?_, ?_, ?_, hδ, ?_, hev⟩
  · simp only [T, ha, hc, hd]; push_cast; ring
  · simp only [U, ha, hb, hc]; push_cast; ring
  · simp only [V, ha, hb, hc, hd]; push_cast; ring
  · simp only [W, ha, hb, hc, hd]; push_cast; ring
  · rintro rfl; exact M.Vand_ne_zero (by simpa using hδ)

/-! #### ℤ[α] -/

theorem pow_mem (k : Fin 4) : M.x 0 ^ (k : ℕ) ∈ M.Zα := Submodule.subset_span ⟨k, rfl⟩

theorem intmul_mem (n : ℤ) {y : O} (hy : y ∈ M.Zα) : (n : O) * y ∈ M.Zα := by
  rw [← zsmul_eq_mul]; exact Submodule.smul_mem _ n hy

theorem one_mem : (1 : O) ∈ M.Zα := by simpa using M.pow_mem 0

theorem x0_mem : M.x 0 ∈ M.Zα := by simpa using M.pow_mem 1

theorem int_mem (n : ℤ) : (n : O) ∈ M.Zα := by simpa using M.intmul_mem n M.one_mem

theorem quartic : M.x 0 ^ 4 = ea M.x * M.x 0 ^ 3 - eb M.x * M.x 0 ^ 2 + ec M.x * M.x 0 - ed M.x := by
  simp only [ea, eb, ec, ed]; ring

theorem x0_mul_mem {y : O} (hy : y ∈ M.Zα) : M.x 0 * y ∈ M.Zα := by
  induction hy using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨k, rfl⟩ := hz
    by_cases hk : (k : ℕ) < 3
    · have := M.pow_mem ⟨(k : ℕ) + 1, by omega⟩
      simpa [pow_succ'] using this
    · have hk3 : (k : ℕ) = 3 := by omega
      simp only [hk3]
      rw [← pow_succ', M.quartic]
      obtain ⟨a, ha⟩ := M.ea_int
      obtain ⟨b, hb⟩ := M.eb_int
      obtain ⟨c, hc⟩ := M.ec_int
      obtain ⟨d, hd⟩ := M.ed_int
      rw [ha, hb, hc, hd]
      refine sub_mem (add_mem (sub_mem (M.intmul_mem a (M.pow_mem 3)) (M.intmul_mem b (M.pow_mem 2)))
        ?_) (M.int_mem d)
      simpa using M.intmul_mem c (M.pow_mem 1)
  | zero => simp
  | add y z _ _ hy hz => rw [mul_add]; exact add_mem hy hz
  | smul n y _ hy => rw [mul_smul_comm]; exact Submodule.smul_mem _ n hy

/-- ℤ[α] (the span) is closed under multiplication, i.e. it is the ring ℤ[α]. -/
theorem Zα_mul_mem {y z : O} (hy : y ∈ M.Zα) (hz : z ∈ M.Zα) : y * z ∈ M.Zα := by
  have hpow : ∀ m : ℕ, M.x 0 ^ m * y ∈ M.Zα := by
    intro m
    induction m with
    | zero => simpa using hy
    | succ m ih => rw [pow_succ', mul_assoc]; exact M.x0_mul_mem ih
  induction hz using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨k, rfl⟩ := hw
    rw [mul_comm]; exact hpow _
  | zero => simp
  | add a b _ _ ha hb => rw [mul_add]; exact add_mem ha hb
  | smul n a _ ha => rw [mul_smul_comm]; exact Submodule.smul_mem _ n ha

/-! #### Necessity (Theorem 1): invariant ⇒ Vand ∣ T, U, V, W -/

/-- D(ω) := det[σ_i(ω_l)] ∈ Vand·ℤ for ω_l ∈ ℤ[α] (Lemma 1.3 in the model). -/
theorem det_mem (w : Fin 4 → O) (hw : ∀ l, w l ∈ M.Zα) :
    ∃ m : ℤ, (Matrix.of fun i l => M.ρ i (w l)).det = Vand M.x * m := by
  have hw' : ∀ l, ∃ c : Fin 4 → ℤ, ∑ k, c k • M.x 0 ^ (k : ℕ) = w l := fun l =>
    (Submodule.mem_span_range_iff_exists_fun ℤ).mp (hw l)
  choose c hc using hw'
  refine ⟨(Matrix.of c).det, det_coord M.x _ (Matrix.of c) ?_⟩
  intro i l
  simp only [Matrix.of_apply]
  rw [← hc l, map_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [zsmul_eq_mul, map_mul, map_intCast, map_pow, M.ρ_x0]

/-- (6.2) in the model: D(1, α, α·τ₁α, α·τ₁α·τ₂α) = −T. -/
theorem dT_eq : (Matrix.of fun i l => M.ρ i (![1, M.x 0, M.x 0 * M.x 1, M.x 0 * M.x 1 * M.x 2] l)).det = -T M.x := by
  rw [det4]; simp [Matrix.of_apply, ρ, M.h₁.1, M.h₁.2.1, M.h₁.2.2.1, M.h₁.2.2.2, M.h₂.1, M.h₂.2.1, M.h₂.2.2.1, M.h₂.2.2.2, M.h₃.1, M.h₃.2.1, M.h₃.2.2.1, M.h₃.2.2.2]; linear_combination detT M.x

/-- (6.3) in the model: D(1, α, τ₁α, τ₂α) = −U. -/
theorem dU_eq : (Matrix.of fun i l => M.ρ i (![1, M.x 0, M.x 1, M.x 2] l)).det = -U M.x := by
  rw [det4]; simp [Matrix.of_apply, ρ, M.h₁.1, M.h₁.2.1, M.h₁.2.2.1, M.h₁.2.2.2, M.h₂.1, M.h₂.2.1, M.h₂.2.2.1, M.h₂.2.2.2, M.h₃.1, M.h₃.2.1, M.h₃.2.2.1, M.h₃.2.2.2]; linear_combination detU M.x

/-- Prop. 2.1(4) in the model. -/
theorem dV_eq : (Matrix.of fun i l => M.ρ i (![1, M.x 0, M.x 1, M.x 0 * M.x 1 + M.x 0 * M.x 2 + M.x 1 * M.x 2] l)).det
    + (Matrix.of fun i l => M.ρ i (![1, M.x 0, M.x 0 * M.x 1, M.x 1 + M.x 2] l)).det = -V M.x := by
  rw [det4, det4]; simp [Matrix.of_apply, ρ, M.h₁.1, M.h₁.2.1, M.h₁.2.2.1, M.h₁.2.2.2, M.h₂.1, M.h₂.2.1, M.h₂.2.2.1, M.h₂.2.2.2, M.h₃.1, M.h₃.2.1, M.h₃.2.2.1, M.h₃.2.2.2]; linear_combination detV M.x

/-- Prop. 2.1(5) in the model. -/
theorem dW_eq : (Matrix.of fun i l => M.ρ i (![1, M.x 0, M.x 1, M.x 0 * M.x 1 * M.x 2] l)).det
    + (Matrix.of fun i l => M.ρ i (![1, M.x 0, M.x 0 * M.x 1, M.x 0 * M.x 2 + M.x 1 * M.x 2] l)).det = -W M.x := by
  rw [det4, det4]; simp [Matrix.of_apply, ρ, M.h₁.1, M.h₁.2.1, M.h₁.2.2.1, M.h₁.2.2.2, M.h₂.1, M.h₂.2.1, M.h₂.2.2.1, M.h₂.2.2.2, M.h₃.1, M.h₃.2.1, M.h₃.2.2.1, M.h₃.2.2.2]; linear_combination detW M.x

theorem nec (hx : ∀ j, M.x j ∈ M.Zα) {t u v w δ : ℤ} (ht : T M.x = t) (hu : U M.x = u)
    (hv : V M.x = v) (hw : W M.x = w) (hδ : Vand M.x = δ) :
    δ ∣ t ∧ δ ∣ u ∧ δ ∣ v ∧ δ ∣ w := by
  have m0 := M.x0_mem
  have m1 := hx 1
  have m2 := hx 2
  have m01 : M.x 0 * M.x 1 ∈ M.Zα := M.Zα_mul_mem m0 m1
  have m012 : M.x 0 * M.x 1 * M.x 2 ∈ M.Zα := M.Zα_mul_mem m01 m2
  have m02 : M.x 0 * M.x 2 ∈ M.Zα := M.Zα_mul_mem m0 m2
  have m12 : M.x 1 * M.x 2 ∈ M.Zα := M.Zα_mul_mem m1 m2
  have key : ∀ (y : O) (s : ℤ) (m : ℤ), y = (s : O) → -y = Vand M.x * m → δ ∣ s := by
    intro y s m hy h
    refine ⟨-m, ?_⟩
    have : (s : O) = ((δ * -m : ℤ) : O) := by rw [← hy]; push_cast; rw [← hδ]; linear_combination -h
    exact_mod_cast this
  have key2 : ∀ (y : O) (s : ℤ) (m m' : ℤ), y = (s : O) →
      -y = Vand M.x * m + Vand M.x * m' → δ ∣ s := by
    intro y s m m' hy h
    exact key y s (m + m') hy (by rw [h]; push_cast; ring)
  refine ⟨?_, ?_, ?_, ?_⟩
  · obtain ⟨m, hm⟩ := M.det_mem ![1, M.x 0, M.x 0 * M.x 1, M.x 0 * M.x 1 * M.x 2]
      (forall4 M.one_mem m0 m01 m012)
    exact key _ t m ht (by rw [← M.dT_eq, hm])
  · obtain ⟨m, hm⟩ := M.det_mem ![1, M.x 0, M.x 1, M.x 2] (forall4 M.one_mem m0 m1 m2)
    exact key _ u m hu (by rw [← M.dU_eq, hm])
  · obtain ⟨m, hm⟩ := M.det_mem ![1, M.x 0, M.x 1, M.x 0 * M.x 1 + M.x 0 * M.x 2 + M.x 1 * M.x 2]
      (forall4 M.one_mem m0 m1 (add_mem (add_mem m01 m02) m12))
    obtain ⟨m', hm'⟩ := M.det_mem ![1, M.x 0, M.x 0 * M.x 1, M.x 1 + M.x 2]
      (forall4 M.one_mem m0 m01 (add_mem m1 m2))
    exact key2 _ v m m' hv (by rw [← M.dV_eq, hm, hm'])
  · obtain ⟨m, hm⟩ := M.det_mem ![1, M.x 0, M.x 1, M.x 0 * M.x 1 * M.x 2]
      (forall4 M.one_mem m0 m1 m012)
    obtain ⟨m', hm'⟩ := M.det_mem ![1, M.x 0, M.x 0 * M.x 1, M.x 0 * M.x 2 + M.x 1 * M.x 2]
      (forall4 M.one_mem m0 m01 (add_mem m02 m12))
    exact key2 _ w m m' hw (by rw [← M.dW_eq, hm, hm'])

/-! #### Sufficiency (Theorem 2 + Cramer), via the pairs (r_j, ΔQ_j) -/

theorem sgn₁ :
    M.τ₁ (r1 M.x) = 1 * r1 M.x ∧ M.τ₁ (dQ1 M.x) = 1 * dQ1 M.x ∧
    M.τ₁ (r2 M.x) = -1 * r2 M.x ∧ M.τ₁ (dQ2 M.x) = -1 * dQ2 M.x ∧
    M.τ₁ (r3 M.x) = -1 * r3 M.x ∧ M.τ₁ (dQ3 M.x) = -1 * dQ3 M.x := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> simp only [r1, r2, r3, dQ1, dQ2, dQ3, map_add, map_sub, map_mul, map_neg, map_pow, map_one, map_zero, map_ofNat, M.h₁.1, M.h₁.2.1, M.h₁.2.2.1, M.h₁.2.2.2, M.h₂.1, M.h₂.2.1, M.h₂.2.2.1, M.h₂.2.2.2, M.h₃.1, M.h₃.2.1, M.h₃.2.2.1, M.h₃.2.2.2] <;> ring

theorem sgn₂ :
    M.τ₂ (r1 M.x) = -1 * r1 M.x ∧ M.τ₂ (dQ1 M.x) = -1 * dQ1 M.x ∧
    M.τ₂ (r2 M.x) = 1 * r2 M.x ∧ M.τ₂ (dQ2 M.x) = 1 * dQ2 M.x ∧
    M.τ₂ (r3 M.x) = -1 * r3 M.x ∧ M.τ₂ (dQ3 M.x) = -1 * dQ3 M.x := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> simp only [r1, r2, r3, dQ1, dQ2, dQ3, map_add, map_sub, map_mul, map_neg, map_pow, map_one, map_zero, map_ofNat, M.h₁.1, M.h₁.2.1, M.h₁.2.2.1, M.h₁.2.2.2, M.h₂.1, M.h₂.2.1, M.h₂.2.2.1, M.h₂.2.2.2, M.h₃.1, M.h₃.2.1, M.h₃.2.2.1, M.h₃.2.2.2] <;> ring

theorem sgn₃ :
    M.τ₃ (r1 M.x) = -1 * r1 M.x ∧ M.τ₃ (dQ1 M.x) = -1 * dQ1 M.x ∧
    M.τ₃ (r2 M.x) = -1 * r2 M.x ∧ M.τ₃ (dQ2 M.x) = -1 * dQ2 M.x ∧
    M.τ₃ (r3 M.x) = 1 * r3 M.x ∧ M.τ₃ (dQ3 M.x) = 1 * dQ3 M.x := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> simp only [r1, r2, r3, dQ1, dQ2, dQ3, map_add, map_sub, map_mul, map_neg, map_pow, map_one, map_zero, map_ofNat, M.h₁.1, M.h₁.2.1, M.h₁.2.2.1, M.h₁.2.2.2, M.h₂.1, M.h₂.2.1, M.h₂.2.2.1, M.h₂.2.2.2, M.h₃.1, M.h₃.2.1, M.h₃.2.2.1, M.h₃.2.2.2] <;> ring

theorem sq_fix (σ : O →+* O) {r q e : O} (he : e * e = 1) (hr : σ r = e * r) (hq : σ q = e * q) :
    σ (r * r) = r * r ∧ σ (r * q) = r * q := by
  constructor
  · rw [map_mul, hr]; linear_combination (r * r) * he
  · rw [map_mul, hr, hq]; linear_combination (r * q) * he

theorem lin_sign (σ : O →+* O) {r q e : O} (u v : ℤ) (hr : σ r = e * r) (hq : σ q = e * q) :
    σ (u * r + v * q) = e * (u * r + v * q) := by
  rw [map_add, map_mul, map_mul, map_intCast, map_intCast, hr, hq]; ring

/-- A pair with invariant r², rq splits as r = nϑ, q = tϑ with gcd(n, t) = 1, ϑ = ur + vq. -/
theorem split_pair {r q : O} {A B : ℤ} (hA : r * r = A) (hB : r * q = B) :
    ∃ n t : ℤ, IsCoprime n t ∧ ∃ ϑ : O, r = n * ϑ ∧ q = t * ϑ ∧
      ∃ u v : ℤ, ϑ = u * r + v * q := by
  rcases eq_or_ne r 0 with hr | hr
  · exact ⟨0, 1, isCoprime_zero_left.mpr isUnit_one, q, by simp [hr], by simp, 0, 1, by simp⟩
  · have hA0 : A ≠ 0 := by
      rintro rfl
      exact hr (mul_self_eq_zero.mp (by simpa using hA))
    have hcop : IsCoprime (A / (Int.gcd A B : ℤ)) (B / (Int.gcd A B : ℤ)) :=
      Int.isCoprime_iff_gcd_eq_one.mpr (Int.gcd_ediv_gcd_ediv_gcd_of_ne_zero_left hA0)
    have eA : A / (Int.gcd A B : ℤ) * (Int.gcd A B : ℤ) = A := Int.ediv_mul_cancel (Int.gcd_dvd_left ..)
    have eB : B / (Int.gcd A B : ℤ) * (Int.gcd A B : ℤ) = B := Int.ediv_mul_cancel (Int.gcd_dvd_right ..)
    set h : ℤ := (Int.gcd A B : ℤ)
    set a' := A / h
    set b' := B / h
    have e1 : (b' : O) * (A : O) = (a' : O) * (B : O) := by
      have : b' * A = a' * B := by
        calc b' * A = b' * (a' * h) := by rw [eA]
          _ = a' * (b' * h) := by ring
          _ = a' * B := by rw [eB]
      exact_mod_cast this
    have key : (b' : O) * r = (a' : O) * q := by
      apply mul_left_cancel₀ hr
      linear_combination (b' : O) * hA - (a' : O) * hB + e1
    obtain ⟨u, v, huv⟩ := hcop
    have huv' : (u : O) * a' + v * b' = 1 := by exact_mod_cast huv
    refine ⟨a', b', ⟨u, v, huv⟩, u * r + v * q, ?_, ?_, u, v, rfl⟩
    · linear_combination (-r) * huv' + (v : O) * key
    · linear_combination (-q) * huv' - (u : O) * key

theorem pair_ints {r q e₁ e₂ e₃ : O} (he₁ : e₁ * e₁ = 1) (he₂ : e₂ * e₂ = 1) (he₃ : e₃ * e₃ = 1)
    (h1r : M.τ₁ r = e₁ * r) (h1q : M.τ₁ q = e₁ * q) (h2r : M.τ₂ r = e₂ * r)
    (h2q : M.τ₂ q = e₂ * q) (h3r : M.τ₃ r = e₃ * r) (h3q : M.τ₃ q = e₃ * q) :
    (∃ A : ℤ, r * r = A) ∧ (∃ B : ℤ, r * q = B) :=
  ⟨M.fix _ (sq_fix _ he₁ h1r h1q).1 (sq_fix _ he₂ h2r h2q).1 (sq_fix _ he₃ h3r h3q).1,
   M.fix _ (sq_fix _ he₁ h1r h1q).2 (sq_fix _ he₂ h2r h2q).2 (sq_fix _ he₃ h3r h3q).2⟩

