module

public import Mathlib.Data.ZMod.Basic
public import Mathlib.Algebra.BigOperators.Group.Finset.Basic
public import Mathlib.Algebra.BigOperators.Intervals
public import Mathlib.FieldTheory.Finite.Basic
public import Mathlib.Tactic.Ring
public import Mathlib.Tactic.FieldSimp

/-!
# Power-sum moments of the half-system T_k in F_p

For a prime p > 7, m = (p-1)/2 and k <= m with 8k(k+1)+1 = 0 in F_p, the half-system T_k = {1,...,k}
u {-(k+1),...,-m} of F_p has odd power-sum moments M_3 = -1/128, M_5 = 7/1536, M_7 = -245/49152 (all
in F_p). The proof reduces M_j(T_k) = 2F_j(k) - F_j(m) for odd j, proves the Faulhaber closed forms
for j = 3, 5, 7 over the integers by induction, and substitutes k(k+1) = -1/8 and m(m+1) = -1/4. The
existence and uniqueness of k (needs (2|p) = 1), the half-system and centring claims and the
semigroup S_{T_k} = <3,5,7> are NOT formalized here; k is taken as a hypothesis.

## Main results

* `P3a.moments_Tk`: M_3, M_5, M_7 of T_k equal -1/128, 7/1536, -245/49152 in F_p for p > 7
* `P3a.moment_Tk_odd`: M_j(T_k) = 2F_j(k) - F_j(m) for odd j

## References

* C. Marín, *The order generated by a column of the SU(n)ₖ S-matrix is locally a numerical semigroup
  ring (Part II)*, Zenodo (2026), doi:10.5281/zenodo.22864267, `prop:familia`.
-/

@[expose] public section

open Finset

namespace P3a

variable {p : ℕ}

/-- The half-system `T_k = {1,…,k} ∪ {-(k+1),…,-m}` in `𝔽_p`, `m = (p-1)/2`. -/
def Tk (p k : ℕ) : Finset (ZMod p) :=
  (Icc 1 k).image (fun r : ℕ => (r : ZMod p)) ∪
    (Icc (k + 1) ((p - 1) / 2)).image (fun r : ℕ => -(r : ZMod p))

/-- The `j`-th power-sum moment of a finite subset of `𝔽_p`. -/
def moment (T : Finset (ZMod p)) (j : ℕ) : ZMod p := ∑ t ∈ T, t ^ j

/-- Partial power sum `F_j(t) = ∑_{r=1}^t r^j` in `ℤ`. -/
def F (j t : ℕ) : ℤ := ∑ r ∈ Icc 1 t, (r : ℤ) ^ j

lemma F_succ (j t : ℕ) : F j (t + 1) = F j t + ((t : ℤ) + 1) ^ j := by
  unfold F
  rw [Finset.sum_Icc_succ_top (by omega : 1 ≤ t + 1)]
  push_cast; ring

lemma F3 (t : ℕ) : 4 * F 3 t = ((t : ℤ) * (t + 1)) ^ 2 := by
  induction t with
  | zero => simp [F]
  | succ n ih => rw [F_succ]; push_cast; nlinarith [ih]

lemma F5 (t : ℕ) : 12 * F 5 t = ((t : ℤ) * (t + 1)) ^ 2 * (2 * ((t : ℤ) * (t + 1)) - 1) := by
  induction t with
  | zero => simp [F]
  | succ n ih => rw [F_succ]; push_cast; nlinarith [ih]

lemma F7 (t : ℕ) : 24 * F 7 t =
    ((t : ℤ) * (t + 1)) ^ 2 * (3 * ((t : ℤ) * (t + 1)) ^ 2 - 4 * ((t : ℤ) * (t + 1)) + 2) := by
  induction t with
  | zero => simp [F]
  | succ n ih => rw [F_succ]; push_cast; nlinarith [ih]

lemma tk_disjoint (hp : 2 < p) (k : ℕ) :
    Disjoint ((Icc 1 k).image (fun r : ℕ => (r : ZMod p)))
      ((Icc (k + 1) ((p - 1) / 2)).image (fun r : ℕ => -(r : ZMod p))) := by
  rw [Finset.disjoint_left]
  intro x hx hx'
  simp only [mem_image, mem_Icc] at hx hx'
  obtain ⟨a, ⟨ha1, ha2⟩, rfl⟩ := hx
  obtain ⟨b, ⟨hb1, hb2⟩, hab⟩ := hx'
  have h0 : ((a + b : ℕ) : ZMod p) = 0 := by push_cast; rw [← hab]; ring
  rw [ZMod.natCast_eq_zero_iff] at h0
  have := Nat.le_of_dvd (by omega) h0
  omega

lemma moment_Tk_odd (hp : 2 < p) (k : ℕ) (hk : k ≤ (p - 1) / 2) (j : ℕ) (hj : Odd j) :
    moment (Tk p k) j =
      2 * ((F j k : ℤ) : ZMod p) - ((F j ((p - 1) / 2) : ℤ) : ZMod p) := by
  unfold moment Tk
  rw [sum_union (tk_disjoint hp k)]
  rw [sum_image (fun a ha b hb h => by
    simp only [coe_Icc, Set.mem_Icc] at ha hb
    rw [ZMod.natCast_eq_natCast_iff'] at h
    rwa [Nat.mod_eq_of_lt (by omega), Nat.mod_eq_of_lt (by omega)] at h)]
  rw [sum_image (fun a ha b hb h => by
    have h' := neg_injective h
    simp only [coe_Icc, Set.mem_Icc] at ha hb
    rw [ZMod.natCast_eq_natCast_iff'] at h'
    rwa [Nat.mod_eq_of_lt (by omega), Nat.mod_eq_of_lt (by omega)] at h')]
  simp only [hj.neg_pow, sum_neg_distrib]
  have e : ∀ n, ((F j n : ℤ) : ZMod p) = ∑ r ∈ Ioc 0 n, (r : ZMod p) ^ j := by
    intro n; unfold F; push_cast; rfl
  have e1 : Icc 1 k = Ioc 0 k := by ext; simp only [mem_Icc, mem_Ioc]; omega
  have e2 : Icc (k + 1) ((p - 1) / 2) = Ioc k ((p - 1) / 2) := by ext; simp only [mem_Icc, mem_Ioc]; omega
  have := Finset.sum_Ioc_consecutive (fun r : ℕ => (r : ZMod p) ^ j) (Nat.zero_le k) hk
  rw [e1, e2, e, e, ← this]
  ring

/-- `k(k+1) = -1/8` and `m(m+1) = -1/4` in `𝔽_p`, from `8k(k+1)+1 = 0` and `2m+1 = p`. -/
lemma uv [Fact p.Prime] (hp : 2 < p) (k : ℕ) (hk8 : (8 * (k : ZMod p) * (k + 1) + 1 = 0)) :
    8 * ((k : ZMod p) * (k + 1)) = -1 ∧
      4 * (((((p - 1) / 2 : ℕ)) : ZMod p) * ((((p - 1) / 2 : ℕ) : ZMod p) + 1)) = -1 := by
  have hodd : p % 2 = 1 := by
    rcases (Fact.out : p.Prime).eq_two_or_odd with h | h <;> omega
  have hm : ((2 * ((p - 1) / 2) + 1 : ℕ) : ZMod p) = 0 := by
    rw [show 2 * ((p - 1) / 2) + 1 = p by omega]; simp
  push_cast at hm
  refine ⟨by linear_combination hk8, ?_⟩
  linear_combination (2 * (((p - 1) / 2 : ℕ) : ZMod p) + 1) * hm

/-- Moments of `T_k` (paper `prop:familia`): `M₃ = -1/128`, `M₅ = 7/1536`, `M₇ = -245/49152`
in `𝔽_p`, for a prime `p > 7` and `k ≤ m = (p-1)/2` with `8k(k+1)+1 = 0`. -/
theorem moments_Tk [Fact p.Prime] (hp : 7 < p) (k : ℕ) (hk : k ≤ (p - 1) / 2)
    (hk8 : (8 * (k : ZMod p) * (k + 1) + 1 = 0)) :
    moment (Tk p k) 3 = -1 / 128 ∧ moment (Tk p k) 5 = 7 / 1536 ∧
      moment (Tk p k) 7 = -245 / 49152 := by
  have hp2 : 2 < p := by omega
  have h2 : (2 : ZMod p) ≠ 0 := by
    have := (ZMod.natCast_eq_zero_iff 2 p).not.mpr
      (fun h => by have := Nat.le_of_dvd (by norm_num) h; omega)
    simpa using this
  have h3 : (3 : ZMod p) ≠ 0 := by
    have := (ZMod.natCast_eq_zero_iff 3 p).not.mpr
      (fun h => by have := Nat.le_of_dvd (by norm_num) h; omega)
    simpa using this
  obtain ⟨hu, hv⟩ := uv hp2 k hk8
  set m := (p - 1) / 2 with hmdef
  set U : ZMod p := (k : ZMod p) * (k + 1) with hU
  set V : ZMod p := (m : ZMod p) * ((m : ZMod p) + 1) with hV
  have n4 : (4 : ZMod p) ≠ 0 := by
    have : (4 : ZMod p) = 2 ^ 2 := by norm_num
    rw [this]; exact pow_ne_zero 2 h2
  have n8 : (8 : ZMod p) ≠ 0 := by
    have : (8 : ZMod p) = 2 ^ 3 := by norm_num
    rw [this]; exact pow_ne_zero 3 h2
  have hU' : U = -1 / 8 := by
    rw [eq_div_iff n8]; linear_combination hu
  have hV' : V = -1 / 4 := by
    rw [eq_div_iff n4]; linear_combination hv
  have c3 : ∀ t : ℕ, 4 * ((F 3 t : ℤ) : ZMod p) = ((t : ZMod p) * (t + 1)) ^ 2 := by
    intro t; have := congrArg (Int.cast : ℤ → ZMod p) (F3 t); push_cast at this; exact this
  have c5 : ∀ t : ℕ, 12 * ((F 5 t : ℤ) : ZMod p) =
      ((t : ZMod p) * (t + 1)) ^ 2 * (2 * ((t : ZMod p) * (t + 1)) - 1) := by
    intro t; have := congrArg (Int.cast : ℤ → ZMod p) (F5 t); push_cast at this; exact this
  have c7 : ∀ t : ℕ, 24 * ((F 7 t : ℤ) : ZMod p) = ((t : ZMod p) * (t + 1)) ^ 2 *
      (3 * ((t : ZMod p) * (t + 1)) ^ 2 - 4 * ((t : ZMod p) * (t + 1)) + 2) := by
    intro t; have := congrArg (Int.cast : ℤ → ZMod p) (F7 t); push_cast at this; exact this
  have n12 : (12 : ZMod p) ≠ 0 := by
    have : (12 : ZMod p) = 4 * 3 := by norm_num
    rw [this]; exact mul_ne_zero n4 h3
  have n24 : (24 : ZMod p) ≠ 0 := by
    have : (24 : ZMod p) = 8 * 3 := by norm_num
    rw [this]; exact mul_ne_zero n8 h3
  have f3 : ∀ t : ℕ, ((F 3 t : ℤ) : ZMod p) = ((t : ZMod p) * (t + 1)) ^ 2 / 4 := fun t =>
    eq_div_of_mul_eq n4 (by rw [mul_comm]; exact c3 t)
  have f5 : ∀ t : ℕ, ((F 5 t : ℤ) : ZMod p) =
      ((t : ZMod p) * (t + 1)) ^ 2 * (2 * ((t : ZMod p) * (t + 1)) - 1) / 12 := fun t =>
    eq_div_of_mul_eq n12 (by rw [mul_comm]; exact c5 t)
  have f7 : ∀ t : ℕ, ((F 7 t : ℤ) : ZMod p) = ((t : ZMod p) * (t + 1)) ^ 2 *
      (3 * ((t : ZMod p) * (t + 1)) ^ 2 - 4 * ((t : ZMod p) * (t + 1)) + 2) / 24 := fun t =>
    eq_div_of_mul_eq n24 (by rw [mul_comm]; exact c7 t)
  have n2 : (2 : ZMod p) ≠ 0 := h2
  have n16 : (16 : ZMod p) ≠ 0 := by
    have : (16 : ZMod p) = 2 ^ 4 := by norm_num
    rw [this]; exact pow_ne_zero 4 h2
  have n64 : (64 : ZMod p) ≠ 0 := by
    have : (64 : ZMod p) = 2 ^ 6 := by norm_num
    rw [this]; exact pow_ne_zero 6 h2
  have n128 : (128 : ZMod p) ≠ 0 := by
    have : (128 : ZMod p) = 2 ^ 7 := by norm_num
    rw [this]; exact pow_ne_zero 7 h2
  have n1536 : (1536 : ZMod p) ≠ 0 := by
    have : (1536 : ZMod p) = 2 ^ 9 * 3 := by norm_num
    rw [this]; exact mul_ne_zero (pow_ne_zero 9 h2) h3
  have n49152 : (49152 : ZMod p) ≠ 0 := by
    have : (49152 : ZMod p) = 2 ^ 14 * 3 := by norm_num
    rw [this]; exact mul_ne_zero (pow_ne_zero 14 h2) h3
  refine ⟨?_, ?_, ?_⟩
  · rw [moment_Tk_odd hp2 k hk 3 (by decide), f3, f3, ← hU, ← hV, hU', hV']
    field_simp; ring
  · rw [moment_Tk_odd hp2 k hk 5 (by decide), f5, f5, ← hU, ← hV, hU', hV']
    field_simp; ring
  · rw [moment_Tk_odd hp2 k hk 7 (by decide), f7, f7, ← hU, ← hV, hU', hV']
    field_simp; ring

end P3a
