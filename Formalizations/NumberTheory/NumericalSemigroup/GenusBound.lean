/-!
# The genus bound for numerical semigroups generated in degrees `≤ D`

For a numerical semigroup `S = ⟨A⟩ ⊆ ℕ` with finitely many gaps, generated by elements `≤ D`, the
genus `g` (number of gaps) satisfies `2g ≤ (κ − 1)(D − 1)` for every `κ > 0` in `S` (the Apéry-set
argument), hence `2g ≤ (D − 1)(D − 2)`, with equality only for `⟨D − 1, D⟩`.

## Main results

* `P3a.genus_pair`, `P3a.conductor_pair`: `⟨m, m + 1⟩` has `m(m − 1)/2` gaps and conductor
  `m(m − 1)` (the Frobenius number from Mathlib's `frobeniusNumber_pair`).
* `P3a.genus_le`: `2g ≤ (κ − 1)(D − 1)`.
* `P3a.genus_le_D`: `2g ≤ (D − 1)(D − 2)`.
* `P3a.eq_pair_of_genus_eq`: equality forces `S = ⟨D − 1, D⟩`.

## References

* C. Marín, *The order generated by a column of the SU(n)_k S-matrix is locally a numerical
  semigroup ring (Part I)*, Zenodo (2026), doi:10.5281/zenodo.22848529.
-/

@[expose] public section

namespace P3a

open Finset

/-- The gaps of the additive submonoid of ℕ generated by `A`. -/
def gaps (A : Set ℕ) : Set ℕ := {x | x ∉ AddSubmonoid.closure A}

/-- The genus: number of gaps (`Set.ncard`, `0` if infinite; every use below assumes finite). -/
noncomputable def genus (A : Set ℕ) : ℕ := (gaps A).ncard

/-! ## The semigroup ⟨m, m+1⟩ -/

/-- Membership in ⟨m, m+1⟩: `x % m ≤ x / m`. -/
theorem mem_pair_iff {m : ℕ} (hm : 0 < m) (x : ℕ) :
    x ∈ AddSubmonoid.closure ({m, m + 1} : Set ℕ) ↔ x % m ≤ x / m := by
  rw [AddSubmonoid.mem_closure_pair]
  constructor
  · rintro ⟨a, b, rfl⟩
    simp only [smul_eq_mul]
    have hx : a * m + b * (m + 1) = b + (a + b) * m := by ring
    rw [hx, Nat.add_mul_mod_self_right]
    have h1 : (a + b) ≤ (b + (a + b) * m) / m := by
      rw [Nat.le_div_iff_mul_le hm]; omega
    have h2 : b % m ≤ b := Nat.mod_le _ _
    omega
  · intro h
    obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le h
    refine ⟨d, x % m, ?_⟩
    simp only [smul_eq_mul]
    have := Nat.div_add_mod x m
    rw [hd] at this
    calc d * m + x % m * (m + 1) = m * (x % m + d) + x % m := by ring
      _ = x := this

theorem filter_lt_range (m q : ℕ) : (range m).filter (fun r => q < r) = Ioo q m := by
  ext r; simp [Finset.mem_Ioo]; omega

/-- `#{(q,r) : q < r < m} * 2 = m(m−1)`. -/
theorem card_pairs_lt (m : ℕ) :
    ((range m ×ˢ range m).filter (fun p : ℕ × ℕ => p.1 < p.2)).card * 2 = m * (m - 1) := by
  rw [Finset.card_filter, Finset.sum_product]
  have h : ∀ q ∈ range m, (∑ r ∈ range m, if q < r then 1 else 0) = m - 1 - q := by
    intro q _
    rw [← Finset.card_filter, filter_lt_range, Nat.card_Ioo]; omega
  rw [Finset.sum_congr rfl h, Finset.sum_range_reflect (fun q => q) m, Finset.sum_range_id_mul_two]

/-- The gaps of ⟨m, m+1⟩ as a finset. -/
theorem gaps_pair_eq {m : ℕ} (hm : 0 < m) :
    gaps ({m, m + 1} : Set ℕ) = ↑((range (m * m)).filter (fun x => x / m < x % m)) := by
  ext x
  simp only [gaps, Set.mem_ofPred_eq, mem_pair_iff hm, coe_filter, mem_range, not_le]
  constructor
  · intro h
    refine ⟨?_, h⟩
    have : x / m < m := lt_of_lt_of_le h (Nat.mod_lt _ hm).le
    exact (Nat.div_lt_iff_lt_mul hm).mp this
  · exact fun h => h.2

/-- **Genus of ⟨m, m+1⟩**: `2·g = m(m−1)`, i.e. `g(⟨n−1,n⟩) = (n−1)(n−2)/2`. -/
theorem genus_pair {m : ℕ} (hm : 0 < m) :
    genus ({m, m + 1} : Set ℕ) * 2 = m * (m - 1) := by
  rw [genus, gaps_pair_eq hm, Set.ncard_coe_finset, ← card_pairs_lt m]
  congr 1
  refine Finset.card_nbij' (fun x => (x / m, x % m)) (fun p => p.1 * m + p.2) ?_ ?_ ?_ ?_
  · intro x hx
    simp only [coe_filter, mem_range, Set.mem_ofPred_eq] at hx
    simp only [coe_filter, mem_product, mem_range, Set.mem_ofPred_eq]
    exact ⟨⟨(Nat.div_lt_iff_lt_mul hm).mpr hx.1, Nat.mod_lt _ hm⟩, hx.2⟩
  · intro p hp
    simp only [coe_filter, mem_product, mem_range, Set.mem_ofPred_eq] at hp
    simp only [coe_filter, mem_range, Set.mem_ofPred_eq]
    have e1 : (p.1 * m + p.2) / m = p.1 := by
      rw [add_comm, Nat.add_mul_div_right _ _ hm, Nat.div_eq_of_lt hp.1.2, zero_add]
    have e2 : (p.1 * m + p.2) % m = p.2 := by
      rw [add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hp.1.2]
    rw [e1, e2]
    refine ⟨?_, hp.2⟩
    have : p.1 * m + p.2 < p.1 * m + m := by omega
    calc p.1 * m + p.2 < p.1 * m + m := this
      _ = (p.1 + 1) * m := by ring
      _ ≤ m * m := Nat.mul_le_mul_right _ hp.1.1
  · intro x _
    simp only
    have := Nat.div_add_mod x m
    calc x / m * m + x % m = m * (x / m) + x % m := by ring
      _ = x := this
  · intro p hp
    simp only [coe_filter, mem_product, mem_range, Set.mem_ofPred_eq] at hp
    have e1 : (p.1 * m + p.2) / m = p.1 := by
      rw [add_comm, Nat.add_mul_div_right _ _ hm, Nat.div_eq_of_lt hp.1.2, zero_add]
    have e2 : (p.1 * m + p.2) % m = p.2 := by
      rw [add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hp.1.2]
    simp only [e1, e2]

/-- **Conductor of ⟨m, m+1⟩** (`m ≥ 2`): every `x ≥ m(m−1)` is in the semigroup and
`m(m−1) − 1` (the Frobenius number `m(m+1) − m − (m+1)`, Mathlib) is not. -/
theorem conductor_pair {m : ℕ} (hm : 2 ≤ m) :
    (m * (m - 1) - 1 ∉ AddSubmonoid.closure ({m, m + 1} : Set ℕ)) ∧
    ∀ x, m * (m - 1) ≤ x → x ∈ AddSubmonoid.closure ({m, m + 1} : Set ℕ) := by
  have cop : Nat.Coprime m (m + 1) := by simp
  have hF := frobeniusNumber_iff.mp (frobeniusNumber_pair cop (by omega) (by omega))
  have e : m * (m + 1) - m - (m + 1) = m * (m - 1) - 1 := by
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hm
    simp only [show 2 + k - 1 = k + 1 by omega]
    have : (2 + k) * (2 + k + 1) = (2 + k) * (k + 1) + 2 * (2 + k) := by ring
    omega
  rw [e] at hF
  refine ⟨hF.1, fun x hx => hF.2 x ?_⟩
  have : 0 < m * (m - 1) := Nat.mul_pos (by omega) (by omega)
  omega

/-! ## The general bound (Apéry elements of multiplicity κ, generators in degrees ≤ D) -/

section General

variable (A : Set ℕ)

/-- `L t`: sums of at most `t` elements of `A`. -/
def L : ℕ → Set ℕ
  | 0 => {0}
  | t + 1 => L t ∪ {z | ∃ y ∈ L t, ∃ a ∈ A, z = y + a}

theorem zero_mem_L : ∀ t, (0 : ℕ) ∈ L A t
  | 0 => rfl
  | t + 1 => Or.inl (zero_mem_L t)

theorem L_sub_closure : ∀ t, L A t ⊆ AddSubmonoid.closure A
  | 0 => by
    intro z hz
    have : z = 0 := hz
    subst this; exact zero_mem _
  | t + 1 => by
    rintro z (hz | ⟨y, hy, a, ha, rfl⟩)
    · exact L_sub_closure t hz
    · exact add_mem (L_sub_closure t hy) (AddSubmonoid.subset_closure ha)

theorem L_le {D : ℕ} (hA : ∀ a ∈ A, a ≤ D) : ∀ t, ∀ y ∈ L A t, y ≤ t * D
  | 0 => by
    intro y hy
    have : y = 0 := hy
    simp [this]
  | t + 1 => by
    rintro z (hz | ⟨y, hy, a, ha, rfl⟩)
    · have := L_le hA t z hz
      rw [Nat.succ_mul]; omega
    · have := L_le hA t y hy
      have := hA a ha
      rw [Nat.succ_mul]; omega

open Classical in
/-- `R κ t`: residues mod `κ` of sums of at most `t` generators. -/
noncomputable def R (κ t : ℕ) : Finset ℕ :=
  (range κ).filter (fun r => ∃ y ∈ L A t, y % κ = r)

theorem mem_R {κ t r : ℕ} : r ∈ R A κ t ↔ r < κ ∧ ∃ y ∈ L A t, y % κ = r := by
  classical
  simp [R]

theorem R_sub (κ t : ℕ) : R A κ t ⊆ range κ := by
  intro r hr; rw [mem_R] at hr; exact mem_range.mpr hr.1

theorem R_succ (κ t : ℕ) : R A κ t ⊆ R A κ (t + 1) := by
  intro r hr
  rw [mem_R] at hr ⊢
  obtain ⟨h1, y, hy, h2⟩ := hr
  exact ⟨h1, y, Or.inl hy, h2⟩

theorem R_mono (κ : ℕ) {s t : ℕ} (h : s ≤ t) : R A κ s ⊆ R A κ t := by
  induction h with
  | refl => exact Finset.Subset.refl _
  | step _ ih => exact ih.trans (R_succ A κ _)

/-- Finitely many gaps: everything above some `B` is in the semigroup. -/
theorem exists_bound (hfin : (gaps A).Finite) :
    ∃ B, ∀ x, B < x → x ∈ AddSubmonoid.closure A := by
  obtain ⟨B, hB⟩ := hfin.bddAbove
  refine ⟨B, fun x hx => ?_⟩
  by_contra h
  have : x ≤ B := hB h
  omega

/-- A semigroup with finitely many gaps meets every residue class. -/
theorem exists_mem_mod (hfin : (gaps A).Finite) {κ r : ℕ} (hr : r < κ) :
    ∃ x ∈ AddSubmonoid.closure A, x % κ = r := by
  obtain ⟨B, hB⟩ := exists_bound A hfin
  refine ⟨r + (B + 1) * κ, hB _ ?_, ?_⟩
  · have : B + 1 ≤ (B + 1) * κ := Nat.le_mul_of_pos_right _ (by omega)
    omega
  · rw [Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hr]

/-- If the residue set stops growing, it is everything. -/
theorem R_stable {κ t : ℕ} (hfin : (gaps A).Finite)
    (h : R A κ (t + 1) = R A κ t) : R A κ t = range κ := by
  have hall : ∀ x ∈ AddSubmonoid.closure A, x % κ ∈ R A κ t ∨ κ = 0 := by
    intro x hx
    induction hx using AddSubmonoid.closure_induction_right with
    | zero =>
      rcases Nat.eq_zero_or_pos κ with h0 | h0
      · exact Or.inr h0
      · left; rw [mem_R]; exact ⟨by simpa using h0, 0, zero_mem_L A t, by simp⟩
    | add_right x _ a ha ih =>
      rcases ih with ih | ih
      · left
        rw [mem_R] at ih
        obtain ⟨_, y, hy, hyx⟩ := ih
        rw [← h, mem_R]
        refine ⟨Nat.mod_lt _ (by omega), y + a, Or.inr ⟨y, hy, a, ha, rfl⟩, ?_⟩
        rw [Nat.add_mod, hyx, ← Nat.add_mod]
      · exact Or.inr ih
  refine Finset.Subset.antisymm (R_sub A κ t) (fun r hr => ?_)
  have hr' : r < κ := mem_range.mp hr
  obtain ⟨x, hx, hxr⟩ := exists_mem_mod A hfin hr'
  rcases hall x hx with h1 | h1
  · rwa [hxr] at h1
  · omega

/-- The residue set grows by at least one per step until it is everything. -/
theorem R_card {κ : ℕ} (hκ : 0 < κ) (hfin : (gaps A).Finite) :
    ∀ t, t + 1 ≤ (R A κ t).card ∨ R A κ t = range κ
  | 0 => by
    left
    have : 0 ∈ R A κ 0 := by
      rw [mem_R]; exact ⟨hκ, 0, rfl, by simp⟩
    simpa using Finset.card_pos.mpr ⟨0, this⟩
  | t + 1 => by
    rcases R_card hκ hfin t with ih | ih
    · by_cases hs : R A κ (t + 1) = R A κ t
      · right; rw [hs]; exact R_stable A hfin hs
      · left
        have hlt : (R A κ t).card < (R A κ (t + 1)).card :=
          Finset.card_lt_card (Finset.ssubset_iff_subset_ne.mpr ⟨R_succ A κ t, Ne.symm hs⟩)
        omega
    · right
      exact Finset.Subset.antisymm (R_sub A κ _) (ih ▸ R_succ A κ t)

open Classical in
/-- The level of a residue: least number of generators reaching it. -/
noncomputable def lev (κ r : ℕ) : ℕ :=
  if h : ∃ t, r ∈ R A κ t then Nat.find h else 0

theorem R_full {κ : ℕ} (hκ : 0 < κ) (hfin : (gaps A).Finite) : R A κ (κ - 1) = range κ := by
  rcases R_card A hκ hfin (κ - 1) with h | h
  · refine Finset.eq_of_subset_of_card_le (R_sub A κ _) ?_
    rw [card_range]; omega
  · exact h

theorem lev_spec {κ r : ℕ} (hκ : 0 < κ) (hfin : (gaps A).Finite) (hr : r < κ) (t : ℕ) :
    lev A κ r ≤ t ↔ r ∈ R A κ t := by
  classical
  have hex : ∃ t, r ∈ R A κ t := ⟨κ - 1, by rw [R_full A hκ hfin]; simpa using hr⟩
  rw [lev, dite_eq_left hex]
  constructor
  · intro h; exact R_mono A κ h (Nat.find_spec hex)
  · intro h; exact Nat.find_min' hex h

/-- `Σ_{r<κ} lev r ≤ Σ_{t<κ} t`. -/
theorem sum_lev_le {κ : ℕ} (hκ : 0 < κ) (hfin : (gaps A).Finite) :
    ∑ r ∈ range κ, lev A κ r ≤ ∑ t ∈ range κ, t := by
  classical
  have hlev : ∀ r ∈ range κ, lev A κ r = ∑ t ∈ range κ, if t < lev A κ r then 1 else 0 := by
    intro r hr
    have hr' : r < κ := mem_range.mp hr
    have hle : lev A κ r ≤ κ - 1 := (lev_spec A hκ hfin hr' _).mpr
      (by rw [R_full A hκ hfin]; simpa using hr')
    rw [← Finset.card_filter]
    have : (range κ).filter (fun t => t < lev A κ r) = range (lev A κ r) := by
      ext t; simp only [mem_filter, mem_range]; omega
    rw [this, card_range]
  rw [Finset.sum_congr rfl hlev, Finset.sum_comm]
  have hcol : ∀ t ∈ range κ,
      (∑ r ∈ range κ, if t < lev A κ r then 1 else 0) ≤ κ - 1 - t := by
    intro t ht
    have ht' : t < κ := mem_range.mp ht
    rw [← Finset.card_filter]
    have hsplit := Finset.card_filter_add_card_filter_not
      (s := range κ) (fun r => t < lev A κ r)
    have hneg : (range κ).filter (fun r => ¬ t < lev A κ r) = R A κ t := by
      ext r
      simp only [mem_filter, mem_range, not_lt]
      constructor
      · rintro ⟨h1, h2⟩; exact (lev_spec A hκ hfin h1 t).mp h2
      · intro h
        have h1 : r < κ := mem_range.mp (R_sub A κ t h)
        exact ⟨h1, (lev_spec A hκ hfin h1 t).mpr h⟩
    rw [hneg, card_range] at hsplit
    rcases R_card A hκ hfin t with h | h
    · omega
    · rw [h, card_range] at hsplit; omega
  calc (∑ t ∈ range κ, ∑ r ∈ range κ, if t < lev A κ r then 1 else 0)
      ≤ ∑ t ∈ range κ, (κ - 1 - t) := Finset.sum_le_sum hcol
    _ = ∑ t ∈ range κ, t := Finset.sum_range_reflect (fun t => t) κ

/-- Gaps in the residue class of `r` lie below an element `y ≡ r` of the semigroup. -/
theorem card_gaps_residue {κ r y : ℕ} (hκS : κ ∈ AddSubmonoid.closure A)
    (hfin : (gaps A).Finite) (hy : y ∈ AddSubmonoid.closure A) (hyr : y % κ = r) :
    κ * (hfin.toFinset.filter (fun x => x % κ = r)).card + r ≤ y := by
  have hsub : hfin.toFinset.filter (fun x => x % κ = r) ⊆
      (range (y / κ)).image (fun j => κ * j + r) := by
    intro x hx
    simp only [mem_filter, Set.Finite.mem_toFinset, gaps, Set.mem_ofPred_eq] at hx
    obtain ⟨hxS, hxr⟩ := hx
    have hxy : x < y := by
      by_contra hc
      push Not at hc
      apply hxS
      have hmod : (x - y) % κ = 0 := Nat.sub_mod_eq_zero_of_mod_eq (by rw [hxr, hyr])
      have hdvd : κ ∣ x - y := Nat.dvd_of_mod_eq_zero hmod
      obtain ⟨k, hk⟩ := hdvd
      have hx' : x = y + k • κ := by rw [smul_eq_mul, mul_comm, ← hk]; omega
      rw [hx']
      exact add_mem hy (nsmul_mem hκS k)
    rw [mem_image]
    refine ⟨x / κ, ?_, ?_⟩
    · rw [mem_range]
      by_contra hc
      push Not at hc
      have h1 := Nat.div_add_mod x κ
      have h2 := Nat.div_add_mod y κ
      have h3 : κ * (y / κ) ≤ κ * (x / κ) := Nat.mul_le_mul_left _ hc
      omega
    · have := Nat.div_add_mod x κ
      omega
  have hc := (Finset.card_le_card hsub).trans Finset.card_image_le
  rw [card_range] at hc
  have h2 := Nat.div_add_mod y κ
  have h3 : κ * (hfin.toFinset.filter (fun x => x % κ = r)).card ≤ κ * (y / κ) :=
    Nat.mul_le_mul_left _ hc
  omega

/-- **Gap bound** (proof of `prop:maximo`): a semigroup generated in degrees `≤ D`, with finitely
many gaps and containing `κ > 0`, has `2·g ≤ (κ−1)(D−1)`. -/
theorem genus_le {D κ : ℕ} (hA : ∀ a ∈ A, a ≤ D) (hfin : (gaps A).Finite)
    (hκ : 0 < κ) (hκS : κ ∈ AddSubmonoid.closure A) :
    2 * genus A ≤ (κ - 1) * (D - 1) := by
  classical
  set G := hfin.toFinset with hG
  have hgen : genus A = G.card := Set.ncard_eq_toFinset_card _ hfin
  have hfib : G.card = ∑ r ∈ range κ, (G.filter (fun x => x % κ = r)).card :=
    Finset.card_eq_sum_card_fiberwise (fun x _ => by simpa using Nat.mod_lt x hκ)
  have hres : ∀ r ∈ range κ,
      κ * (G.filter (fun x => x % κ = r)).card + r ≤ lev A κ r * D := by
    intro r hr
    have hr' : r < κ := mem_range.mp hr
    have hmem : r ∈ R A κ (lev A κ r) := (lev_spec A hκ hfin hr' _).mp le_rfl
    rw [mem_R] at hmem
    obtain ⟨_, y, hy, hyr⟩ := hmem
    exact (card_gaps_residue A hκS hfin (L_sub_closure A _ hy) hyr).trans
      (L_le A hA _ y hy)
  have hsum := Finset.sum_le_sum hres
  rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.sum_mul, ← hfib] at hsum
  have hlev := sum_lev_le A hκ hfin
  have hT := Finset.sum_range_id_mul_two κ
  set T := ∑ t ∈ range κ, t
  -- κ·g + T ≤ D·T, 2T = κ(κ−1)
  have h1 : κ * G.card + T ≤ T * D :=
    hsum.trans (Nat.mul_le_mul_right _ hlev)
  have h2 : κ * (2 * G.card + (κ - 1)) ≤ κ * (D * (κ - 1)) := by
    have e1 : κ * (2 * G.card + (κ - 1)) = 2 * (κ * G.card + T) := by
      rw [mul_add, ← hT]; ring
    have e2 : κ * (D * (κ - 1)) = 2 * (T * D) := by
      rw [← mul_assoc, mul_comm κ D, mul_assoc, ← hT]; ring
    rw [e1, e2]; exact Nat.mul_le_mul_left _ h1
  have h3 := Nat.le_of_mul_le_mul_left h2 hκ
  rw [hgen]
  have e3 : (κ - 1) * (D - 1) = D * (κ - 1) - (κ - 1) := by
    rw [Nat.mul_sub_one, mul_comm]
  rw [e3]; omega

/-- If every generator is divisible by `d ≥ 2`, there are infinitely many gaps. -/
theorem not_all_dvd (hfin : (gaps A).Finite) {d : ℕ} (hd : 2 ≤ d) : ¬ ∀ a ∈ A, d ∣ a := by
  intro hall
  have hS : ∀ x ∈ AddSubmonoid.closure A, d ∣ x := fun x hx =>
    AddSubmonoid.closure_induction (fun a ha => hall a ha) (dvd_zero d)
      (fun _ _ _ _ h1 h2 => dvd_add h1 h2) hx
  obtain ⟨B, hB⟩ := exists_bound A hfin
  have hx := hS _ (hB (1 + (B + 1) * d) (by
    have : B + 1 ≤ (B + 1) * d := Nat.le_mul_of_pos_right _ (by omega)
    omega))
  rw [Nat.dvd_iff_mod_eq_zero, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt (by omega)] at hx
  omega

/-- **`prop:maximo`, the bound**: generated in degrees `≤ D`, finitely many gaps ⇒
`2·g ≤ (D−1)(D−2)`, i.e. `δ ≤ (n−1)(n−2)/2` with `D = n`. -/
theorem genus_le_D {D : ℕ} (hA : ∀ a ∈ A, a ≤ D) (hfin : (gaps A).Finite) :
    2 * genus A ≤ (D - 1) * (D - 2) := by
  by_cases hsmall : ∃ κ ∈ AddSubmonoid.closure A, 0 < κ ∧ κ < D
  · obtain ⟨κ, hκS, hκ0, hκD⟩ := hsmall
    refine (genus_le A hA hfin hκ0 hκS).trans ?_
    rw [mul_comm (D - 1)]
    exact Nat.mul_le_mul_right _ (by omega)
  · push Not at hsmall
    obtain ⟨B, hB⟩ := exists_bound A hfin
    by_cases hD : D ≤ 1
    · have := genus_le A hA hfin (κ := B + 1) (by omega) (hB _ (by omega))
      have e : D - 1 = 0 := by omega
      rw [e, mul_zero] at this
      omega
    · exfalso
      apply not_all_dvd A hfin (d := D) (by omega)
      intro a ha
      rcases Nat.eq_zero_or_pos a with h0 | h0
      · rw [h0]; exact dvd_zero D
      · have := hsmall a (AddSubmonoid.subset_closure ha) h0
        have := hA a ha
        rw [show a = D by omega]

/-- **`prop:maximo`, the equality case (semigroup part)**: `D ≥ 3`, generated in degrees `≤ D`,
finitely many gaps and `2·g = (D−1)(D−2)` ⇒ the semigroup is `⟨D−1, D⟩`. -/
theorem eq_pair_of_genus_eq {D : ℕ} (hD : 3 ≤ D) (hA : ∀ a ∈ A, a ≤ D)
    (hfin : (gaps A).Finite) (heq : 2 * genus A = (D - 1) * (D - 2)) :
    AddSubmonoid.closure A = AddSubmonoid.closure ({D - 1, D} : Set ℕ) := by
  -- every positive element is ≥ D − 1
  have hmult : ∀ κ ∈ AddSubmonoid.closure A, 0 < κ → D - 1 ≤ κ := by
    intro κ hκS hκ
    by_contra hc
    push Not at hc
    have h1 := genus_le A hA hfin hκ hκS
    have h2 : (κ - 1) * (D - 1) < (D - 2) * (D - 1) :=
      Nat.mul_lt_mul_of_pos_right (by omega) (by omega)
    rw [mul_comm (D - 2)] at h2
    omega
  have hgen : ∀ a ∈ A, a = 0 ∨ a = D - 1 ∨ a = D := by
    intro a ha
    have := hA a ha
    rcases Nat.eq_zero_or_pos a with h0 | h0
    · exact Or.inl h0
    · have := hmult a (AddSubmonoid.subset_closure ha) h0
      omega
  have hD1 : D - 1 ∈ A := by
    by_contra hc
    apply not_all_dvd A hfin (d := D) (by omega)
    intro a ha
    rcases hgen a ha with h | h | h
    · rw [h]; exact dvd_zero D
    · exact absurd (h ▸ ha) hc
    · rw [h]
  have hD2 : D ∈ A := by
    by_contra hc
    apply not_all_dvd A hfin (d := D - 1) (by omega)
    intro a ha
    rcases hgen a ha with h | h | h
    · rw [h]; exact dvd_zero _
    · rw [h]
    · exact absurd (h ▸ ha) hc
  apply le_antisymm
  · rw [AddSubmonoid.closure_le]
    intro a ha
    rcases hgen a ha with h | h | h
    · rw [h]; exact zero_mem _
    · exact AddSubmonoid.subset_closure (by rw [h]; exact Set.mem_insert _ _)
    · exact AddSubmonoid.subset_closure (by rw [h]; exact Set.mem_insert_of_mem _ rfl)
  · rw [AddSubmonoid.closure_le]
    rintro x (rfl | rfl)
    · exact AddSubmonoid.subset_closure hD1
    · exact AddSubmonoid.subset_closure hD2

end General

/-- The bound is attained: `⟨n−1, n⟩` (`n ≥ 2`) has `2·g = (n−1)(n−2)`. -/
theorem genus_pair_n {n : ℕ} (hn : 2 ≤ n) :
    2 * genus ({n - 1, n} : Set ℕ) = (n - 1) * (n - 2) := by
  have h := genus_pair (m := n - 1) (by omega)
  rw [show n - 1 + 1 = n by omega, show n - 1 - 1 = n - 2 by omega] at h
  omega

end P3a
