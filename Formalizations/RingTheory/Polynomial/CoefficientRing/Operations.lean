/-!
# Three operations on segment polynomials

Let `t` be a primitive `2q`-th root of unity in a field `K`. A segment polynomial is
`seg t a n = ∏_{j<n} (X − t^(a − 2j))`, a string of `n` roots with step `t⁻²`; `F t n` is the
segment of `SU(n)` (exponents `n − 1, n − 3, …, 1 − n`) and `Gsp t m` that of `Sp(2m)`. The
subrings `A` generated by their coefficients satisfy three identities.

## Main results

* `NotaPuente.A_F_odd_eq_A_Gsp`: `A_SU(2m+1) = A_Sp(2m)`.
* `NotaPuente.A_F_eq_A_F_sub`: `A_SU(n) = A_SU(q−n)` for `n ≤ q`.
* `NotaPuente.A_F_add_q`: `A_SU(n+q) = A_SU(n)`.
* `NotaPuente.A_neg`, `NotaPuente.A_comp_neg_X`: `A` is invariant under `p ↦ −p` and
  `p ↦ p(−X)`.

## References

* C. Marín, *Non-real orders of character values of `GL(n)`*, preprint (2026).
* C. Marín, *The ring of character values depends only on the segment: SU(n), Sp(2m) and GL(n) at
  a torsion element*, Zenodo (2026), doi:10.5281/zenodo.22847476.
-/

@[expose] public section

namespace NotaPuente

open Polynomial

section Division

variable {R : Type*} [CommRing R]

/-! New general facts about `A`: invariance under `p ↦ -p` and `p ↦ p(-X)`. -/

theorem A_neg (p : R[X]) : A (-p) = A p := by
  apply le_antisymm
  · rw [A_le_iff]; intro n; rw [coeff_neg]; exact neg_mem (coeff_mem_A p n)
  · rw [A_le_iff]; intro n
    have h := neg_mem (coeff_mem_A (-p) n); rwa [coeff_neg, neg_neg] at h

theorem A_neg_one_pow_mul (k : ℕ) (p : R[X]) : A ((-1) ^ k * p) = A p := by
  rcases neg_one_pow_eq_or R[X] k with h | h <;> rw [h]
  · rw [one_mul]
  · rw [neg_one_mul, A_neg]

theorem A_comp_neg_X_le (p : R[X]) : A (p.comp (-X)) ≤ A p := by
  rw [A_le_iff]; intro n
  have sp : (p.coeffs : Set R) ⊆ A p := fun c hc => Subring.subset_closure hc
  have e : p.comp (-X) = ((p.toSubring (A p) sp).comp (-X)).map (A p).subtype := by
    rw [Polynomial.map_comp, map_toSubring, Polynomial.map_neg, map_X]
  rw [e, coeff_map]
  exact (((p.toSubring (A p) sp).comp (-X)).coeff n).2

theorem A_comp_neg_X (p : R[X]) : A (p.comp (-X)) = A p :=
  le_antisymm (A_comp_neg_X_le p) (by
    have h := A_comp_neg_X_le (p.comp (-X)); rwa [comp_neg_X_comp_neg_X] at h)

theorem A_neg_one_pow_mul_comp (k : ℕ) (p : R[X]) : A ((-1) ^ k * p.comp (-X)) = A p := by
  rw [A_neg_one_pow_mul, A_comp_neg_X]

end Division

section Segments

variable {K : Type*} [Field K]

/-- String of `n` roots `t^a, t^(a-2), …, t^(a-2(n-1))`. -/
noncomputable def seg (t : K) (a : ℤ) (n : ℕ) : K[X] :=
  ∏ j ∈ Finset.range n, (X - C (t ^ (a - 2 * (j : ℤ))))

/-- Segment polynomial of SU(n). -/
noncomputable def F (t : K) (n : ℕ) : K[X] := seg t ((n : ℤ) - 1) n

/-- Segment polynomial of Sp(2m). -/
noncomputable def Gsp (t : K) (m : ℕ) : K[X] :=
  ∏ j ∈ Finset.range m, (X - C (t ^ (2 * ((j : ℤ) + 1)))) * (X - C (t ^ (-(2 * ((j : ℤ) + 1)))))

theorem seg_monic (t : K) (a : ℤ) (n : ℕ) : (seg t a n).Monic :=
  monic_prod_of_monic _ _ fun _ _ => monic_X_sub_C _

theorem seg_add (t : K) (a : ℤ) (n k : ℕ) :
    seg t a (n + k) = seg t a n * seg t (a - 2 * n) k := by
  unfold seg
  rw [Finset.prod_range_add]
  congr 1
  refine Finset.prod_congr rfl fun x _ => ?_
  rw [show a - 2 * ((n + x : ℕ) : ℤ) = a - 2 * n - 2 * x by push_cast; ring]

theorem seg_zero (t : K) (a : ℤ) : seg t a 0 = 1 := by simp [seg]

theorem seg_one (t : K) (a : ℤ) : seg t a 1 = X - C (t ^ a) := by simp [seg]

variable {t : K} {q : ℕ}

theorem pow_q_eq_neg_one (hq : 0 < q) (ht : IsPrimitiveRoot t (2 * q)) : t ^ q = -1 := by
  have h1 : t ^ q * t ^ q = 1 := by rw [← pow_add, ← two_mul]; exact ht.pow_eq_one
  rcases mul_self_eq_one_iff.mp h1 with h | h
  · exact absurd h (ht.pow_ne_one_of_pos_of_lt hq.ne' (by omega))
  · exact h

theorem t_ne_zero (hq : 0 < q) (ht : IsPrimitiveRoot t (2 * q)) : t ≠ 0 :=
  ht.ne_zero (by omega)

/-- Translation by q: shifting every exponent by `-q` multiplies each root by `t^(-q) = -1`. -/
theorem seg_sub_q (hq : 0 < q) (ht : IsPrimitiveRoot t (2 * q)) (a : ℤ) (n : ℕ) :
    seg t (a - q) n = (-1) ^ n * (seg t a n).comp (-X) := by
  have h0 := t_ne_zero hq ht
  have hq1 := pow_q_eq_neg_one hq ht
  induction n with
  | zero => simp [seg]
  | succ n ih =>
    unfold seg at ih ⊢
    rw [Finset.prod_range_succ, Finset.prod_range_succ, ih, mul_comp, sub_comp, X_comp, C_comp]
    have hr : t ^ (a - q - 2 * (n : ℤ)) = -t ^ (a - 2 * (n : ℤ)) := by
      rw [show a - q - 2 * (n : ℤ) = (a - 2 * n) + (-(q : ℤ)) by ring, zpow_add₀ h0, zpow_neg,
        zpow_natCast, hq1]
      simp
    rw [hr, C_neg]
    ring

/-- A full parity class: `q` consecutive roots of the string give `X^q - c`, `c = (t^a)^q = ±1`;
hence it is the image of a monic integer polynomial. -/
theorem seg_q_int (hq : 0 < q) (ht : IsPrimitiveRoot t (2 * q)) (a : ℤ) :
    ∃ H : ℤ[X], H.Monic ∧ seg t a q = H.map (Int.castRingHom K) := by
  have h0 := t_ne_zero hq ht
  have hz : IsPrimitiveRoot ((t ^ 2)⁻¹) q := (ht.pow (by omega) (by ring)).inv
  have hprod := X_pow_sub_C_eq_prod hz hq (rfl : (t ^ a) ^ q = (t ^ a) ^ q)
  have hseg : seg t a q = X ^ q - C ((t ^ a) ^ q) := by
    rw [hprod]
    refine Finset.prod_congr rfl fun i _ => ?_
    rw [show a - 2 * (i : ℤ) = a + (-((2 * i : ℕ) : ℤ)) by push_cast; ring, zpow_add₀ h0,
      zpow_neg, zpow_natCast, inv_pow, ← pow_mul, mul_comm]
  have hc : (t ^ a) ^ q = 1 ∨ (t ^ a) ^ q = -1 := by
    rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, pow_q_eq_neg_one hq ht]
    rcases Int.even_or_odd a with h | h
    · left; exact h.neg_one_zpow
    · right; exact h.neg_one_zpow
  rcases hc with h | h
  · refine ⟨X ^ q - C 1, monic_X_pow_sub_C _ hq.ne', ?_⟩
    rw [hseg, h]; simp
  · refine ⟨X ^ q - C (-1), monic_X_pow_sub_C _ hq.ne', ?_⟩
    rw [hseg, h]; simp

/-! ### Proposition 2.2 -/

/-- Factorisation behind (a): `F (2m+1) = Gsp m * (X - 1)`. -/
theorem F_odd_eq (t : K) (m : ℕ) : F t (2 * m + 1) = Gsp t m * (X - C 1) := by
  have e1 : F t (2 * m + 1) = seg t (2 * m) m * seg t 0 (1 + m) := by
    unfold F
    rw [show 2 * m + 1 = m + (1 + m) by ring, seg_add]
    congr 2 <;> push_cast <;> ring
  have e2 : seg t 0 (1 + m) = (X - C 1) * seg t (-2) m := by
    rw [seg_add, seg_one, zpow_zero]; congr 2
  have e3 : seg t (2 * m) m = ∏ j ∈ Finset.range m, (X - C (t ^ (2 * ((j : ℤ) + 1)))) := by
    rw [← Finset.prod_range_reflect (fun j : ℕ => X - C (t ^ (2 * ((j : ℤ) + 1)))) m]
    unfold seg
    refine Finset.prod_congr rfl fun j hj => ?_
    have hj' := Finset.mem_range.mp hj
    have : ((m - 1 - j : ℕ) : ℤ) = (m : ℤ) - 1 - j := by omega
    simp only [this]
    congr 3; ring
  have e4 : Gsp t m = seg t (2 * m) m * seg t (-2) m := by
    unfold Gsp
    rw [Finset.prod_mul_distrib, e3]
    congr 1
    unfold seg
    refine Finset.prod_congr rfl fun j _ => ?_
    congr 3; ring
  rw [e1, e2, e4]; ring

/-- **Prop. 2.2(a)**: `A_SU(2m+1) = A_Sp(2m)` (no hypothesis on `t` needed). -/
theorem A_F_odd_eq_A_Gsp (t : K) (m : ℕ) : A (F t (2 * m + 1)) = A (Gsp t m) := by
  have h := A_mul_int_monic (Gsp t m) (H := X - C 1) (monic_X_sub_C 1)
  rw [Polynomial.map_sub, map_X, map_C, map_one] at h
  rw [F_odd_eq, h]

/-- **Prop. 2.2(b)**: `A_SU(n) = A_SU(q-n)` for `n ≤ q` (the paper states `1 ≤ n < q`). -/
theorem A_F_eq_A_F_sub (hq : 0 < q) (ht : IsPrimitiveRoot t (2 * q)) {n : ℕ} (hn : n ≤ q) :
    A (F t n) = A (F t (q - n)) := by
  obtain ⟨H, hH, hseg⟩ := seg_q_int hq ht ((n : ℤ) - 1)
  have hsplit : seg t ((n : ℤ) - 1) q = F t n * seg t ((n : ℤ) - 1 - 2 * n) (q - n) := by
    unfold F; rw [← seg_add, Nat.add_sub_cancel' hn]
  have hG : seg t ((n : ℤ) - 1 - 2 * n) (q - n) =
      (-1) ^ (q - n) * (F t (q - n)).comp (-X) := by
    unfold F
    rw [← seg_sub_q hq ht]
    congr 1; push_cast [Nat.cast_sub hn]; ring
  have h1 := A_eq_of_mul_int (seg_monic t _ n) (seg_monic t _ _) (hsplit ▸ hseg)
  unfold F at h1 ⊢
  rw [h1]
  have h2 := A_neg_one_pow_mul_comp (q - n) (F t (q - n))
  unfold F at h2 hG
  rw [hG, h2]

/-- **Prop. 2.2(c)**: `A_SU(n+q) = A_SU(n)`. -/
theorem A_F_add_q (hq : 0 < q) (ht : IsPrimitiveRoot t (2 * q)) (n : ℕ) :
    A (F t (n + q)) = A (F t n) := by
  obtain ⟨H, hH, hseg⟩ := seg_q_int hq ht (((n + q : ℕ) : ℤ) - 1)
  have hsplit : F t (n + q) = seg t ((n : ℤ) - 1 - q) n * H.map (Int.castRingHom K) := by
    unfold F
    rw [add_comm n q, seg_add, ← hseg, mul_comm]
    congr 1
    · congr 1; push_cast; ring
    · rw [add_comm q n]
  have hG : seg t ((n : ℤ) - 1 - q) n = (-1) ^ n * (F t n).comp (-X) := by
    unfold F; rw [seg_sub_q hq ht]
  rw [hsplit, A_mul_int_monic _ hH, hG, A_neg_one_pow_mul_comp]

end Segments

end NotaPuente
