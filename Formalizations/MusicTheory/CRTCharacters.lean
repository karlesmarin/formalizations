module

public import Formalizations.MusicTheory.CycleGraphSpectrum

/-!
# CRT coordinates of the characters of `ℤ/12`

Under `ℤ/12 ≅ ℤ/3 × ℤ/4`, the character `χ_k = dftChar k` (`j ↦ exp(2πi·jk/12)`) factors through
the projection to `ℤ/3` exactly when `k ∈ {0, 4, 8}` and through the projection to `ℤ/4` exactly when
`k ∈ {0, 3, 6, 9}`. So `χ_4` generates the augmented (`ℤ/3`) axis, `χ_3` the diminished (`ℤ/4`) axis,
and the tritone `χ_6` is the element of order `2` of the `ℤ/4` part: the indices `3` and `4` swap.

## Main results

* `dftChar_eq_dftChar_iff`: two values of a character agree iff `x * k = y * k` in `ZMod N`.
* `factorsThrough_three_iff`: `χ_k` factors through `ℤ/12 → ℤ/3` iff `k ∈ {0, 4, 8}`.
* `factorsThrough_four_iff`: `χ_k` factors through `ℤ/12 → ℤ/4` iff `k ∈ {0, 3, 6, 9}`.
* `three_axis_eq_multiples_four`, `four_axis_eq_multiples_three`, `six_order_two`: the two axes are
  generated by `4` and by `3`, and `6` has order `2`.

## References

* C. Marín, *The Tonnetz spectrum is the generating triad's Fourier balance profile*,
  Zenodo (2026), doi:10.5281/zenodo.20862821, Proposition 2.
-/

@[expose] public section

namespace MusicTheory

namespace CRTCharacters

open CycleGraphSpectrum

/-- Two values of the character `dftChar k` agree iff `x * k = y * k`: `stdAddChar` is injective. -/
theorem dftChar_eq_dftChar_iff {N : ℕ} [NeZero N] (k x y : ZMod N) :
    dftChar k x = dftChar k y ↔ x * k = y * k := by
  simp only [dftChar_apply, ZMod.injective_stdAddChar.eq_iff]

/-- The character `χ_k` of `ℤ/12` factors through the map `f`: it is constant on the fibres of `f`. -/
def FactorsThrough {M : Type*} (f : ZMod 12 → M) (k : ZMod 12) : Prop :=
  ∀ x y : ZMod 12, f x = f y → dftChar k x = dftChar k y

/-- The projection `ℤ/12 → ℤ/3`. -/
abbrev toThree : ZMod 12 →+* ZMod 3 := ZMod.castHom (by norm_num) (ZMod 3)

/-- The projection `ℤ/12 → ℤ/4`. -/
abbrev toFour : ZMod 12 →+* ZMod 4 := ZMod.castHom (by norm_num) (ZMod 4)

/-- For a ring homomorphism `f`, `χ_k` factors through `f` iff `k` kills the kernel of `f`. -/
theorem factorsThrough_iff {R : Type*} [CommRing R] (f : ZMod 12 →+* R) (k : ZMod 12) :
    FactorsThrough f k ↔ ∀ d : ZMod 12, f d = 0 → d * k = 0 := by
  simp only [FactorsThrough, dftChar_eq_dftChar_iff]
  constructor
  · intro h d hd
    simpa using h d 0 (by simp [hd])
  · intro h x y hxy
    exact sub_eq_zero.mp (by rw [← sub_mul]; exact h (x - y) (by simp [hxy]))

/-- **Proposition 2, first half.** `χ_k` factors through `ℤ/3` iff `k ∈ {0, 4, 8}`. -/
theorem factorsThrough_three_iff (k : ZMod 12) :
    FactorsThrough toThree k ↔ k ∈ ({0, 4, 8} : Finset (ZMod 12)) := by
  rw [factorsThrough_iff]
  revert k
  decide

/-- **Proposition 2, second half.** `χ_k` factors through `ℤ/4` iff `k ∈ {0, 3, 6, 9}`. -/
theorem factorsThrough_four_iff (k : ZMod 12) :
    FactorsThrough toFour k ↔ k ∈ ({0, 3, 6, 9} : Finset (ZMod 12)) := by
  rw [factorsThrough_iff]
  revert k
  decide

/-- The `ℤ/3` axis is generated by `4`. -/
theorem three_axis_eq_multiples_four :
    (Finset.univ.image fun j : ZMod 12 => j * 4) = ({0, 4, 8} : Finset (ZMod 12)) := by
  decide

/-- The `ℤ/4` axis is generated by `3`. -/
theorem four_axis_eq_multiples_three :
    (Finset.univ.image fun j : ZMod 12 => j * 3) = ({0, 3, 6, 9} : Finset (ZMod 12)) := by
  decide

/-- The tritone `6` is the element of order `2` of the `ℤ/4` axis. -/
theorem six_order_two : (6 : ZMod 12) ≠ 0 ∧ 2 * (6 : ZMod 12) = 0 ∧
    (6 : ZMod 12) ∈ ({0, 3, 6, 9} : Finset (ZMod 12)) := by
  decide

end CRTCharacters

end MusicTheory
